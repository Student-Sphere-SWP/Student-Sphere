<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div style="max-width:900px;margin:0 auto;">
  <div style="margin-bottom:24px;">
    <a href="/mentor/sessions" style="color:#a78bfa;font-size:13px;font-weight:600;text-decoration:none;">← My Sessions</a>
    <h1 style="font-size:26px;font-weight:800;color:#f8fafc;margin:8px 0 0 0;letter-spacing:-0.5px;"><%= session.session_title %></h1>
    <p style="color:#64748b;font-size:14px;margin:4px 0 0 0;">
      <%= new Date(session.session_date).toLocaleDateString('en-GB', {weekday:'long', day:'numeric', month:'long', year:'numeric'}) %>
      <% if (session.session_time) { %> at <%= session.session_time.slice(0,5) %><% } %>
      <% if (session.location) { %> · 📍 <%= session.location %><% } %>
    </p>
  </div>

  <div class="grid grid-cols-3 gap-4" style="margin-bottom:24px;">
    <div class="card text-center">
      <p class="text-2xl font-bold text-gray-900"><%= rsvps.length %></p>
      <p class="text-xs text-gray-500 mt-1">RSVPs</p>
    </div>
    <div class="card text-center">
      <p class="text-2xl font-bold text-green-600"><%= rsvps.filter(r => r.attended).length %></p>
      <p class="text-xs text-gray-500 mt-1">Attended</p>
    </div>
    <div class="card text-center">
      <p class="text-2xl font-bold text-gray-400"><%= rsvps.filter(r => !r.attended).length %></p>
      <p class="text-xs text-gray-500 mt-1">Not Marked</p>
    </div>
  </div>

  <div class="card">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
      <div style="width:4px;height:24px;background:linear-gradient(180deg,#c4b5fd,#7c3aed);border-radius:2px;"></div>
      <h2 style="font-size:18px;font-weight:700;color:#f8fafc;margin:0;">Attendees</h2>
    </div>

    <% if (!rsvps.length) { %>
      <div style="text-align:center;padding:60px 20px;">
        <p style="color:#94a3b8;font-size:16px;font-weight:600;">No students have RSVP'd to this session.</p>
      </div>
    <% } else { %>
    <form method="POST" action="/mentor/sessions/<%= session.id %>/attendance">
      <div class="space-y-2 mb-4">
        <% rsvps.forEach(r => { %>
        <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-radius:14px;border:1px solid rgba(255,255,255,0.08);background:rgba(20,16,38,0.6);">
          <div class="flex items-center gap-3">
            <% if (r.profile_picture) { %>
              <img src="<%= r.profile_picture %>" class="w-8 h-8 rounded-full object-cover" />
            <% } else { %>
              <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center text-xs font-bold text-indigo-600">
                <%= r.name.charAt(0).toUpperCase() %>
              </div>
            <% } %>
            <div>
              <p class="text-sm font-medium text-gray-700"><%= r.name %></p>
              <p class="text-xs text-gray-400"><%= r.email %></p>
            </div>
          </div>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" name="attended_<%= r.user_id %>" value="1"
                   class="rounded text-green-600 focus:ring-green-500"
                   <%= r.attended ? 'checked' : '' %> />
            <span class="text-xs text-gray-600">Attended</span>
          </label>
        </div>
        <% }) %>
      </div>
      <button type="submit" class="btn-primary">Save Attendance</button>
    </form>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>