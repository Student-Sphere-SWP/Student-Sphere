<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div style="max-width:1200px;margin:0 auto;">

  <!-- Header -->
  <div style="margin-bottom:24px;">
    <a href="/mentor/dashboard" style="color:#a78bfa;font-size:13px;font-weight:600;text-decoration:none;">← Dashboard</a>
    <h1 style="font-size:26px;font-weight:800;color:#f8fafc;margin:8px 0 0 0;letter-spacing:-0.5px;">My Notes</h1>
    <p style="color:#64748b;font-size:14px;margin:4px 0 0 0;">Upload and manage your tutorial notes for students.</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Upload form -->
    <div class="card" style="height:fit-content;">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
        <div style="width:4px;height:24px;background:linear-gradient(180deg,#c4b5fd,#7c3aed);border-radius:2px;"></div>
        <h2 style="font-size:16px;font-weight:700;color:#f8fafc;margin:0;">Upload a Note</h2>
      </div>
      <form method="POST" action="/mentor/upload-note" enctype="multipart/form-data" class="space-y-4">
        <div>
          <label class="form-label">Module</label>
          <select name="module_id" required class="form-input">
            <option value="">Select module...</option>
            <% modules.forEach(m => { %>
              <option value="<%= m.id %>"><%= m.module_name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="form-label">Topic Name</label>
          <input type="text" name="topic_name" required class="form-input" maxlength="255" placeholder="e.g. Linked Lists Revision" />
        </div>
        <div>
          <label class="form-label">PDF File</label>
          <input type="file" name="pdf" accept="application/pdf" required class="form-input text-sm py-1.5" />
        </div>
        <button type="submit" class="btn-primary w-full justify-center">Upload PDF</button>
      </form>
    </div>

    <!-- Notes list -->
    <div class="lg:col-span-2">

      <!-- Filter -->
      <form method="GET" action="/mentor/my-notes" class="flex flex-wrap gap-3 card py-3 px-4" style="margin-bottom:16px;">
        <select name="module_id" class="form-input w-auto">
          <option value="">All modules</option>
          <% modules.forEach(m => { %>
            <option value="<%= m.id %>" <%= filterModuleId == m.id ? 'selected' : '' %>><%= m.module_name %></option>
          <% }) %>
        </select>
        <button type="submit" class="btn-secondary">Filter</button>
        <% if (filterModuleId) { %>
          <a href="/mentor/my-notes" class="btn-secondary">Clear</a>
        <% } %>
      </form>

      <% if (!notes.length) { %>
        <div style="text-align:center;padding:60px 20px;">
          <span style="font-size:48px;display:block;margin-bottom:16px;">📄</span>
          <p style="color:#94a3b8;font-size:16px;font-weight:600;">No notes uploaded yet.</p>
          <p style="color:#64748b;font-size:14px;margin:8px 0 0 0;">Upload a PDF using the form on the left.</p>
        </div>
      <% } else { %>
        <div class="space-y-3">
          <% notes.forEach(n => { %>
          <div class="card" style="padding:16px 20px;">
            <div class="flex items-start justify-between gap-4">
              <div class="flex items-start gap-3 min-w-0">
                <span style="font-size:24px;flex-shrink:0;">📄</span>
                <div class="min-w-0">
                  <p style="font-size:14px;font-weight:600;color:#f1f5f9;margin:0 0 2px 0;"><%= n.topic_name %></p>
                  <p style="font-size:12px;color:#94a3b8;margin:0;">
                    <span style="color:#c4b5fd;font-weight:600;"><%= n.module_name %></span>
                    &middot; <%= n.file_name %>
                    <% if (n.file_size) { %> &middot; <%= Math.round(n.file_size / 1024) %> KB<% } %>
                  </p>
                  <p style="font-size:11px;color:#64748b;margin:4px 0 0 0;">
                    Uploaded <%= new Date(n.created_at).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %>
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-2 flex-shrink-0">
                <a href="<%= n.file_url %>" target="_blank" rel="noopener" class="btn-secondary text-xs">View</a>
                <form method="POST" action="/mentor/notes/<%= n.id %>?_method=DELETE" onsubmit="return confirm('Delete this note?')">
                  <button type="submit" class="btn-danger text-xs">Delete</button>
                </form>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>