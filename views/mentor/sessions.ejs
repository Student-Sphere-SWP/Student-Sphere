<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div style="max-width:900px;margin:0 auto;">
  <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;margin-bottom:24px;">
    <h1 style="font-size:26px;font-weight:800;color:#f8fafc;margin:0;letter-spacing:-0.5px;">My Sessions</h1>
    <button onclick="document.getElementById('create-modal').classList.remove('hidden')"
            class="btn-primary">+ New Session</button>
  </div>

  <% if (!sessions.length) { %>
    <div style="text-align:center;padding:60px 20px;">
      <span style="font-size:48px;display:block;margin-bottom:16px;">📅</span>
      <p style="color:#94a3b8;font-size:16px;font-weight:600;">No sessions created yet. Click "New Session" to get started.</p>
    </div>
  <% } else { %>
  <div class="space-y-3">
    <% sessions.forEach(s => { %>
    <div class="card">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="text-sm font-semibold text-gray-800"><%= s.topic %></p>
          <p class="text-xs text-gray-400 mt-0.5">
            <%= new Date(s.date_time).toLocaleDateString('en-GB', {weekday:'short', day:'numeric', month:'short', year:'numeric'}) %>
            at <strong><%= new Date(s.date_time).toLocaleTimeString('en-GB', {hour:'2-digit', minute:'2-digit'}) %></strong>
            <% if (s.meeting_link_or_location) { %> · 📍 <%= s.meeting_link_or_location %><% } %>
          </p>
          <div class="flex flex-wrap gap-2 mt-1">
            <span class="badge bg-gray-100 text-gray-600"><%= s.module_name %></span>
            <span class="badge bg-blue-100 text-blue-700"><%= s.rsvp_count %>/<%= s.capacity %> RSVPs</span>
          </div>
          <% if (s.description) { %><p class="text-xs text-gray-500 mt-1 line-clamp-2"><%= s.description %></p><% } %>
        </div>
        <div class="flex gap-2 flex-shrink-0">
          <a href="/mentor/sessions/<%= s.id %>/rsvps" class="btn-secondary text-xs">RSVPs</a>
          <button onclick='openEditSession(<%= JSON.stringify({
            id: s.id, topic: s.topic,
            date_time: s.date_time ? (s.date_time instanceof Date ? s.date_time : new Date(s.date_time)).toISOString().slice(0,16) : "",
            meeting_link_or_location: s.meeting_link_or_location || "",
            capacity: s.capacity,
            module_id: s.module_id,
            description: s.description || ""
          }) %>)' class="btn-secondary text-xs">Edit</button>
          <form method="POST" action="/mentor/sessions/<%= s.id %>?_method=DELETE"
                onsubmit="return confirm('Delete this session?')">
            <button type="submit" class="btn-danger text-xs">Delete</button>
          </form>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>

<!-- Create Session Modal -->
<div id="create-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black bg-opacity-40" onclick="document.getElementById('create-modal').classList.add('hidden')"></div>
  <div style="position:relative;background:rgba(15,12,30,0.95);backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,0.15);border-radius:24px;padding:32px;width:100%;max-width:480px;max-height:90vh;overflow-y:auto;">
    <h2 style="font-size:18px;font-weight:700;color:#f8fafc;margin:0 0 20px 0;">New Session</h2>
    <form method="POST" action="/mentor/sessions" class="space-y-3">
      <div>
        <label class="form-label">Module</label>
        <select name="module_id" class="form-input" required>
          <option value="">Select…</option>
          <% modules.forEach(m => { %>
          <option value="<%= m.id %>"><%= m.module_name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="form-label">Title</label>
        <input type="text" name="topic" class="form-input" required maxlength="255" placeholder="e.g. Data Structures Revision" />
      </div>
      <div>
        <label class="form-label">Date &amp; Time</label>
        <input type="datetime-local" name="date_time" class="form-input" required />
      </div>
      <div>
        <label class="form-label">Location / Meeting Link</label>
        <input type="text" name="meeting_link_or_location" class="form-input" maxlength="255" placeholder="e.g. Room 101 or Zoom link" />
      </div>
      <div>
        <label class="form-label">Max Students</label>
        <input type="number" name="capacity" class="form-input" min="1" max="500" value="20" required />
      </div>
      <div>
        <label class="form-label">Description (optional)</label>
        <textarea name="description" rows="2" class="form-input" maxlength="1000"></textarea>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="document.getElementById('create-modal').classList.add('hidden')"
                class="btn-secondary flex-1 justify-center">Cancel</button>
        <button type="submit" class="btn-primary flex-1 justify-center">Create</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Session Modal -->
<div id="edit-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black bg-opacity-40" onclick="document.getElementById('edit-modal').classList.add('hidden')"></div>
  <div style="position:relative;background:rgba(15,12,30,0.95);backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,0.15);border-radius:24px;padding:32px;width:100%;max-width:480px;max-height:90vh;overflow-y:auto;">
    <h2 style="font-size:18px;font-weight:700;color:#f8fafc;margin:0 0 20px 0;">Edit Session</h2>
    <form id="edit-form" method="POST" class="space-y-3">
      <div>
        <label class="form-label">Module</label>
        <select name="module_id" id="edit-module" class="form-input" required>
          <% modules.forEach(m => { %>
          <option value="<%= m.id %>"><%= m.module_name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="form-label">Title</label>
        <input type="text" name="topic" id="edit-title" class="form-input" required maxlength="255" />
      </div>
      <div>
        <label class="form-label">Date &amp; Time</label>
        <input type="datetime-local" name="date_time" id="edit-datetime" class="form-input" required />
      </div>
      <div>
        <label class="form-label">Location / Meeting Link</label>
        <input type="text" name="meeting_link_or_location" id="edit-location" class="form-input" maxlength="255" />
      </div>
      <div>
        <label class="form-label">Max Students</label>
        <input type="number" name="capacity" id="edit-max" class="form-input" min="1" max="500" required />
      </div>
      <div>
        <label class="form-label">Description (optional)</label>
        <textarea name="description" id="edit-desc" rows="2" class="form-input" maxlength="1000"></textarea>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="document.getElementById('edit-modal').classList.add('hidden')"
                class="btn-secondary flex-1 justify-center">Cancel</button>
        <button type="submit" class="btn-primary flex-1 justify-center">Save</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openEditSession(s) {
    document.getElementById('edit-form').action = '/mentor/sessions/' + s.id + '?_method=PUT';
    document.getElementById('edit-title').value    = s.topic;
    document.getElementById('edit-datetime').value = s.date_time;
    document.getElementById('edit-location').value = s.meeting_link_or_location;
    document.getElementById('edit-max').value      = s.capacity;
    document.getElementById('edit-desc').value     = s.description;
    document.getElementById('edit-module').value   = s.module_id;
    document.getElementById('edit-modal').classList.remove('hidden');
  }
</script>

<%- include('../partials/footer') %>