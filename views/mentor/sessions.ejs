<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div class="space-y-6">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-bold text-gray-900">My Sessions</h1>
    <button onclick="document.getElementById('create-modal').classList.remove('hidden')"
            class="btn-primary">+ New Session</button>
  </div>

  <!-- Sessions list -->
  <% if (!sessions.length) { %>
    <div class="card text-center py-12 text-gray-400">
      <p class="text-4xl mb-3">📅</p>
      <p>No sessions created yet. Click "New Session" to get started.</p>
    </div>
  <% } else { %>
  <div class="space-y-3">
    <% sessions.forEach(s => { %>
    <div class="card">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="text-sm font-semibold text-gray-800"><%= s.session_title %></p>
          <p class="text-xs text-gray-400 mt-0.5">
            <%= new Date(s.session_date).toLocaleDateString('en-GB', {weekday:'short', day:'numeric', month:'short', year:'numeric'}) %>
            at <strong><%= s.session_time ? s.session_time.slice(0,5) : 'TBD' %></strong>
            <% if (s.location) { %> · 📍 <%= s.location %><% } %>
          </p>
          <div class="flex flex-wrap gap-2 mt-1">
            <span class="badge bg-gray-100 text-gray-600"><%= s.module_name %></span>
            <span class="badge bg-blue-100 text-blue-700"><%= s.rsvp_count %>/<%= s.max_students %> RSVPs</span>
          </div>
          <% if (s.description) { %><p class="text-xs text-gray-500 mt-1 line-clamp-2"><%= s.description %></p><% } %>
        </div>
        <div class="flex gap-2 flex-shrink-0">
          <a href="/mentor/sessions/<%= s.id %>/rsvps" class="btn-secondary text-xs">RSVPs</a>
          <button onclick='openEditSession(<%= JSON.stringify({
            id: s.id, session_title: s.session_title,
            session_date: s.session_date ? s.session_date.toISOString ? s.session_date.toISOString().slice(0,10) : String(s.session_date).slice(0,10) : "",
            session_time: s.session_time || "",
            location: s.location || "",
            max_students: s.max_students,
            module_id: s.module_id,
            description: s.description || ""
          }) %>)' class="btn-secondary text-xs">Edit</button>
          <form method="POST" action="/mentor/sessions/<%= s.id %>?_method=DELETE"
                onsubmit="return confirm('Delete this session?')">
            <button type="submit" class="btn-danger text-xs">Delete</button>
          </form>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>

<!-- Create Session Modal -->
<div id="create-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black bg-opacity-40"
       onclick="document.getElementById('create-modal').classList.add('hidden')"></div>
  <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-md p-6 overflow-y-auto max-h-[90vh]">
    <h2 class="text-lg font-semibold text-gray-800 mb-4">New Session</h2>
    <form method="POST" action="/mentor/sessions" class="space-y-3">
      <div>
        <label class="form-label">Module</label>
        <select name="module_id" class="form-input" required>
          <option value="">Select…</option>
          <% modules.forEach(m => { %>
          <option value="<%= m.id %>"><%= m.module_name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="form-label">Title</label>
        <input type="text" name="session_title" class="form-input" required maxlength="255" placeholder="e.g. Data Structures Revision" />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="form-label">Date</label>
          <input type="date" name="session_date" class="form-input" required />
        </div>
        <div>
          <label class="form-label">Time</label>
          <input type="time" name="session_time" class="form-input" />
        </div>
      </div>
      <div>
        <label class="form-label">Location</label>
        <input type="text" name="location" class="form-input" maxlength="255" placeholder="e.g. Room 101 or Zoom link" />
      </div>
      <div>
        <label class="form-label">Max Students</label>
        <input type="number" name="max_students" class="form-input" min="1" max="200" value="20" required />
      </div>
      <div>
        <label class="form-label">Description (optional)</label>
        <textarea name="description" rows="2" class="form-input" maxlength="1000"></textarea>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="document.getElementById('create-modal').classList.add('hidden')"
                class="btn-secondary flex-1 justify-center">Cancel</button>
        <button type="submit" class="btn-primary flex-1 justify-center">Create</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Session Modal -->
<div id="edit-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black bg-opacity-40"
       onclick="document.getElementById('edit-modal').classList.add('hidden')"></div>
  <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-md p-6 overflow-y-auto max-h-[90vh]">
    <h2 class="text-lg font-semibold text-gray-800 mb-4">Edit Session</h2>
    <form id="edit-form" method="POST" class="space-y-3">
      <div>
        <label class="form-label">Module</label>
        <select name="module_id" id="edit-module" class="form-input" required>
          <% modules.forEach(m => { %>
          <option value="<%= m.id %>"><%= m.module_name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="form-label">Title</label>
        <input type="text" name="session_title" id="edit-title" class="form-input" required maxlength="255" />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="form-label">Date</label>
          <input type="date" name="session_date" id="edit-date" class="form-input" required />
        </div>
        <div>
          <label class="form-label">Time</label>
          <input type="time" name="session_time" id="edit-time" class="form-input" />
        </div>
      </div>
      <div>
        <label class="form-label">Location</label>
        <input type="text" name="location" id="edit-location" class="form-input" maxlength="255" />
      </div>
      <div>
        <label class="form-label">Max Students</label>
        <input type="number" name="max_students" id="edit-max" class="form-input" min="1" max="200" required />
      </div>
      <div>
        <label class="form-label">Description (optional)</label>
        <textarea name="description" id="edit-desc" rows="2" class="form-input" maxlength="1000"></textarea>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="document.getElementById('edit-modal').classList.add('hidden')"
                class="btn-secondary flex-1 justify-center">Cancel</button>
        <button type="submit" class="btn-primary flex-1 justify-center">Save</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openEditSession(s) {
    document.getElementById('edit-form').action = '/mentor/sessions/' + s.id + '?_method=PUT';
    document.getElementById('edit-title').value = s.session_title;
    document.getElementById('edit-date').value = s.session_date;
    document.getElementById('edit-time').value = s.session_time;
    document.getElementById('edit-location').value = s.location;
    document.getElementById('edit-max').value = s.max_students;
    document.getElementById('edit-desc').value = s.description;
    document.getElementById('edit-module').value = s.module_id;
    document.getElementById('edit-modal').classList.remove('hidden');
  }
</script>

<%- include('../partials/footer') %>
