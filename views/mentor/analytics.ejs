<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div style="max-width:1100px;margin:0 auto;">

  <!-- Header -->
  <div style="margin-bottom:24px;">
    <a href="/mentor/dashboard" style="color:#a78bfa;font-size:13px;font-weight:600;text-decoration:none;">← Dashboard</a>
    <h1 style="font-size:26px;font-weight:800;color:#f8fafc;margin:8px 0 0 0;letter-spacing:-0.5px;">Module Analytics</h1>
    <p style="color:#64748b;font-size:14px;margin:4px 0 0 0;"><%= moduleName %></p>
  </div>

  <!-- Quiz stat cards -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4" style="margin-bottom:16px;">
    <div class="card text-center">
      <p class="text-2xl font-bold" style="color:#f1f5f9;"><%= stats.totalStudents %></p>
      <p class="text-xs mt-1" style="color:#64748b;">Students Enrolled</p>
    </div>
    <div class="card text-center">
      <p class="text-2xl font-bold" style="color:#a78bfa;"><%= stats.totalAttempts %></p>
      <p class="text-xs mt-1" style="color:#64748b;">Quiz Attempts</p>
    </div>
    <div class="card text-center">
      <p class="text-2xl font-bold" style="color:#22c55e;"><%= stats.avgScore ? parseFloat(stats.avgScore).toFixed(1) : '—' %>%</p>
      <p class="text-xs mt-1" style="color:#64748b;">Avg Quiz Score</p>
    </div>
    <div class="card text-center">
      <p class="text-2xl font-bold" style="color:#eab308;"><%= stats.avgRating ? parseFloat(stats.avgRating).toFixed(1) : '—' %> ★</p>
      <p class="text-xs mt-1" style="color:#64748b;">Your Avg Rating</p>
    </div>
  </div>

  <!-- Session stat cards -->
  <div style="display:flex;align-items:center;gap:12px;margin:24px 0 12px 0;">
    <div style="width:4px;height:24px;background:linear-gradient(180deg,#67e8f9,#0891b2);border-radius:2px;"></div>
    <h2 style="font-size:18px;font-weight:700;color:#f8fafc;margin:0;">Session Overview</h2>
  </div>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4" style="margin-bottom:24px;">
    <div class="card text-center">
      <p class="text-2xl font-bold" style="color:#67e8f9;"><%= sessionSummary.total_sessions %></p>
      <p class="text-xs mt-1" style="color:#64748b;">Sessions Hosted</p>
    </div>
    <div class="card text-center">
      <p class="text-2xl font-bold" style="color:#818cf8;"><%= sessionSummary.total_rsvps %></p>
      <p class="text-xs mt-1" style="color:#64748b;">Total RSVPs</p>
    </div>
    <div class="card text-center">
      <p class="text-2xl font-bold" style="color:#34d399;"><%= sessionSummary.total_attended %></p>
      <p class="text-xs mt-1" style="color:#64748b;">Total Attended</p>
    </div>
    <div class="card text-center">
      <%
        const rsvpNum = Number(sessionSummary.total_rsvps);
        const attNum  = Number(sessionSummary.total_attended);
        const rate    = rsvpNum > 0 ? Math.round((attNum / rsvpNum) * 100) : null;
      %>
      <p class="text-2xl font-bold" style="color:<%= rate === null ? '#64748b' : rate >= 70 ? '#22c55e' : rate >= 40 ? '#eab308' : '#ef4444' %>;">
        <%= rate !== null ? rate + '%' : '—' %>
      </p>
      <p class="text-xs mt-1" style="color:#64748b;">Attendance Rate</p>
    </div>
  </div>

  <!-- Recent sessions table -->
  <div class="card" style="margin-bottom:24px;">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
      <div style="width:4px;height:24px;background:linear-gradient(180deg,#67e8f9,#0891b2);border-radius:2px;"></div>
      <h2 style="font-size:16px;font-weight:700;color:#f8fafc;margin:0;">Recent Sessions</h2>
    </div>
    <% if (!recentSessions.length) { %>
      <div style="text-align:center;padding:40px 20px;">
        <p style="color:#94a3b8;font-size:15px;font-weight:600;">No sessions hosted yet for this module.</p>
      </div>
    <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr style="border-bottom:1px solid rgba(255,255,255,0.08);">
            <th class="text-left py-2 px-3 text-xs font-semibold uppercase tracking-wider" style="color:#64748b;">Topic</th>
            <th class="text-center py-2 px-3 text-xs font-semibold uppercase tracking-wider" style="color:#64748b;">Date</th>
            <th class="text-center py-2 px-3 text-xs font-semibold uppercase tracking-wider" style="color:#64748b;">Capacity</th>
            <th class="text-center py-2 px-3 text-xs font-semibold uppercase tracking-wider" style="color:#64748b;">RSVPs</th>
            <th class="text-center py-2 px-3 text-xs font-semibold uppercase tracking-wider" style="color:#64748b;">Attended</th>
            <th class="text-center py-2 px-3 text-xs font-semibold uppercase tracking-wider" style="color:#64748b;">Rate</th>
          </tr>
        </thead>
        <tbody>
          <% recentSessions.forEach(s => { %>
          <% const r = Number(s.rsvp_count); const a = Number(s.attended_count); const sr = r > 0 ? Math.round((a/r)*100) : null; %>
          <tr style="border-bottom:1px solid rgba(255,255,255,0.05);">
            <td class="py-3 px-3 font-medium" style="color:#f1f5f9;"><%= s.topic %></td>
            <td class="py-3 px-3 text-center" style="color:#94a3b8;font-size:12px;">
              <%= new Date(s.date_time).toLocaleDateString('en-GB', {day:'numeric',month:'short',year:'numeric'}) %>
            </td>
            <td class="py-3 px-3 text-center" style="color:#94a3b8;"><%= s.capacity %></td>
            <td class="py-3 px-3 text-center">
              <span style="font-weight:600;color:#818cf8;"><%= r %></span>
            </td>
            <td class="py-3 px-3 text-center">
              <span style="font-weight:600;color:#34d399;"><%= a %></span>
            </td>
            <td class="py-3 px-3 text-center">
              <% if (sr !== null) { %>
                <span style="font-size:12px;font-weight:700;padding:2px 8px;border-radius:20px;
                  background:<%= sr >= 70 ? 'rgba(34,197,94,0.15)' : sr >= 40 ? 'rgba(234,179,8,0.15)' : 'rgba(239,68,68,0.15)' %>;
                  color:<%= sr >= 70 ? '#22c55e' : sr >= 40 ? '#eab308' : '#ef4444' %>;">
                  <%= sr %>%
                </span>
              <% } else { %>
                <span style="color:#475569;">—</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

  <!-- Quiz topic chart -->
  <% if (topicStats.length) { %>
  <div class="card" style="margin-bottom:24px;">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
      <div style="width:4px;height:24px;background:linear-gradient(180deg,#c4b5fd,#7c3aed);border-radius:2px;"></div>
      <h2 style="font-size:16px;font-weight:700;color:#f8fafc;margin:0;">Avg Quiz Score by Topic</h2>
    </div>
    <canvas id="topicChart" height="90"></canvas>
  </div>
  <% } %>

  <!-- Topic breakdown table -->
  <div class="card">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
      <div style="width:4px;height:24px;background:linear-gradient(180deg,#c4b5fd,#7c3aed);border-radius:2px;"></div>
      <h2 style="font-size:16px;font-weight:700;color:#f8fafc;margin:0;">Topic Breakdown</h2>
    </div>
    <% if (!topicStats.length) { %>
      <div style="text-align:center;padding:40px 20px;">
        <p style="color:#94a3b8;font-size:15px;font-weight:600;">No quiz attempts recorded yet.</p>
      </div>
    <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr style="border-bottom:1px solid rgba(255,255,255,0.08);">
            <th class="text-left py-2 px-3 text-xs font-semibold uppercase tracking-wider" style="color:#64748b;">Topic</th>
            <th class="text-center py-2 px-3 text-xs font-semibold uppercase tracking-wider" style="color:#64748b;">Attempts</th>
            <th class="text-center py-2 px-3 text-xs font-semibold uppercase tracking-wider" style="color:#64748b;">Avg Score</th>
            <th class="text-center py-2 px-3 text-xs font-semibold uppercase tracking-wider" style="color:#64748b;">Top Score</th>
          </tr>
        </thead>
        <tbody>
          <% topicStats.forEach(t => { %>
          <% const avg = parseFloat(t.avg_score) || 0; %>
          <tr style="border-bottom:1px solid rgba(255,255,255,0.05);">
            <td class="py-3 px-3 font-medium" style="color:#f1f5f9;"><%= t.topic_name %></td>
            <td class="py-3 px-3 text-center" style="color:#94a3b8;"><%= t.attempts %></td>
            <td class="py-3 px-3 text-center">
              <div class="flex items-center justify-center gap-2">
                <div style="width:80px;height:6px;background:rgba(255,255,255,0.1);border-radius:9999px;overflow:hidden;">
                  <div style="width:<%= avg %>%;height:100%;border-radius:9999px;background:<%= avg >= 70 ? '#22c55e' : avg >= 50 ? '#eab308' : '#ef4444' %>;"></div>
                </div>
                <span style="font-size:12px;font-weight:700;color:#f8fafc;"><%= avg.toFixed(0) %>%</span>
              </div>
            </td>
            <td class="py-3 px-3 text-center" style="color:#6ee7b7;font-weight:600;"><%= parseFloat(t.top_score).toFixed(0) %>%</td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

</div>

<% if (topicStats.length) { %>
<script>
  new Chart(document.getElementById('topicChart'), {
    type: 'bar',
    data: {
      labels: <%- JSON.stringify(topicStats.map(t => t.topic_name)) %>,
      datasets: [{
        label: 'Avg Score %',
        data: <%- JSON.stringify(topicStats.map(t => parseFloat(t.avg_score).toFixed(1))) %>,
        backgroundColor: <%- JSON.stringify(topicStats.map(t => parseFloat(t.avg_score) >= 70 ? 'rgba(34,197,94,0.7)' : parseFloat(t.avg_score) >= 50 ? 'rgba(234,179,8,0.7)' : 'rgba(239,68,68,0.7)')) %>,
        borderRadius: 6
      }]
    },
    options: {
      indexAxis: 'y',
      plugins: { legend: { display: false } },
      scales: {
        x: { beginAtZero: true, max: 100, ticks: { callback: v => v + '%' } },
        y: { ticks: { font: { size: 11 } } }
      }
    }
  });
</script>
<% } %>

<%- include('../partials/footer') %>