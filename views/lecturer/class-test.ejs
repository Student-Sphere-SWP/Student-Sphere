<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div class="max-w-4xl mx-auto space-y-6">

  <!-- Header -->
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <a href="/lecturer/modules/<%= ct.module_id %>" class="text-gray-400 hover:text-gray-600 text-sm">← <%= ct.module_name %></a>
      <h1 class="text-2xl font-bold text-gray-900"><%= ct.title %></h1>
      <span class="badge bg-indigo-100 text-indigo-700">Out of <%= ct.total_marks %></span>
    </div>
    <form method="POST" action="/lecturer/class-tests/<%= ct.id %>?_method=DELETE"
          onsubmit="return confirm('Delete this class test and all marks?')">
      <button type="submit" class="btn-secondary text-xs text-red-600 border-red-200 hover:bg-red-50">🗑 Delete Test</button>
    </form>
  </div>

  <!-- Meta info -->
  <div class="card flex flex-wrap gap-6 text-sm text-gray-600">
    <div><span class="font-medium text-gray-800">Linked Notes:</span> 📄 <%= ct.pdf_topic %></div>
    <% if (ct.test_date) { %>
    <div><span class="font-medium text-gray-800">Date:</span> <%= new Date(ct.test_date).toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric' }) %></div>
    <% } %>
    <div><span class="font-medium text-gray-800">Students:</span> <%= students.length %></div>
    <div><span class="font-medium text-gray-800">Marked:</span> <%= students.filter(s => s.marks_obtained !== null).length %> / <%= students.length %></div>
  </div>

  <!-- Marks entry form -->
  <div class="card">
    <h2 class="text-base font-semibold text-gray-800 mb-4">Enter / Update Marks</h2>

    <% if (!students.length) { %>
      <p class="text-gray-400 text-sm text-center py-6">No students are enrolled in this module yet.</p>
    <% } else { %>
    <form method="POST" action="/lecturer/class-tests/<%= ct.id %>/marks">
      <div class="space-y-2 mb-6">
        <!-- Column headers -->
        <div class="grid grid-cols-[1fr_160px_120px] gap-3 px-2 pb-1 border-b border-gray-100 text-xs font-semibold text-gray-400 uppercase tracking-wide">
          <span>Student</span>
          <span>Marks (max <%= ct.total_marks %>)</span>
          <span>Percentage</span>
        </div>

        <% students.forEach(s => { %>
        <%
          const pct = s.marks_obtained !== null
            ? Math.round((parseFloat(s.marks_obtained) / parseFloat(ct.total_marks)) * 100)
            : null;
          const barColor = pct === null ? 'bg-gray-200' : pct >= 75 ? 'bg-emerald-500' : pct >= 50 ? 'bg-yellow-400' : 'bg-red-400';
        %>
        <div class="grid grid-cols-[1fr_160px_120px] gap-3 items-center py-2 px-2 rounded-lg hover:bg-gray-50">
          <!-- Name + student number -->
          <div class="flex items-center gap-2 min-w-0">
            <div class="w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 font-bold text-xs flex items-center justify-center flex-shrink-0">
              <%= s.name.charAt(0).toUpperCase() %>
            </div>
            <div class="min-w-0">
              <p class="text-sm text-gray-800 truncate"><%= s.name %></p>
              <% if (s.student_number) { %><p class="text-xs text-gray-400"><%= s.student_number %></p><% } %>
            </div>
          </div>

          <!-- Marks input -->
          <input
            type="number"
            name="marks[<%= s.id %>]"
            min="0"
            max="<%= ct.total_marks %>"
            step="0.5"
            value="<%= s.marks_obtained !== null ? s.marks_obtained : '' %>"
            placeholder="—"
            class="form-input text-sm py-1.5 pct-input"
            data-total="<%= ct.total_marks %>"
            data-student="<%= s.id %>"
          />

          <!-- Live percentage -->
          <div class="flex items-center gap-2">
            <div class="flex-1 h-1.5 bg-gray-100 rounded-full overflow-hidden">
              <div class="h-full rounded-full transition-all <%= barColor %> pct-bar" id="bar-<%= s.id %>"
                   style="width: <%= pct !== null ? pct : 0 %>%"></div>
            </div>
            <span class="text-xs font-semibold text-gray-500 w-10 text-right pct-label" id="pct-<%= s.id %>">
              <%= pct !== null ? pct + '%' : '—' %>
            </span>
          </div>
        </div>
        <% }) %>
      </div>

      <div class="flex items-center justify-between">
        <p class="text-xs text-gray-400">Leave blank to skip a student. Saves overwrite existing marks.</p>
        <button type="submit" class="btn-primary">💾 Save All Marks</button>
      </div>
    </form>
    <% } %>
  </div>
</div>

<script>
// Live percentage update as lecturer types
document.querySelectorAll('.pct-input').forEach(input => {
  input.addEventListener('input', function () {
    const total = parseFloat(this.dataset.total);
    const id    = this.dataset.student;
    const val   = parseFloat(this.value);
    const bar   = document.getElementById('bar-' + id);
    const label = document.getElementById('pct-' + id);
    if (isNaN(val) || this.value === '') {
      bar.style.width = '0%';
      bar.className = bar.className.replace(/bg-\w+-\d+/, 'bg-gray-200');
      label.textContent = '—';
    } else {
      const pct = Math.min(Math.round((val / total) * 100), 100);
      bar.style.width = pct + '%';
      const color = pct >= 75 ? 'bg-emerald-500' : pct >= 50 ? 'bg-yellow-400' : 'bg-red-400';
      bar.className = bar.className.replace(/bg-\w+-\d+/, color);
      label.textContent = pct + '%';
    }
  });
});
</script>

<%- include('../partials/footer') %>
