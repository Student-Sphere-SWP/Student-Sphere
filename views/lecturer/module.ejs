<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <a href="/lecturer/dashboard" class="text-gray-400 hover:text-gray-600 text-sm">← Dashboard</a>
      <div class="flex items-center gap-2">
        <div class="w-3 h-3 rounded-full" style="background-color: <%= module.colour %>"></div>
        <h1 class="text-2xl font-bold text-gray-900"><%= module.module_name %></h1>
        <span class="badge bg-gray-100 text-gray-600"><%= module.module_code %></span>
      </div>
    </div>
    <div class="flex gap-2">
      <a href="/lecturer/analytics/<%= module.id %>" class="btn-secondary text-xs">📊 Analytics</a>
      <a href="/lecturer/pdf-analytics/<%= module.id %>" class="btn-secondary text-xs">📄 PDF Analytics</a>
      <a href="/lecturer/announcements/create?moduleId=<%= module.id %>" class="btn-secondary text-xs">📢 Post Announcement</a>
      <a href="/lecturer/create-quiz?moduleId=<%= module.id %>" class="btn-secondary text-xs">📝 Create Quiz</a>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <!-- Left: PDF Notes -->
    <div class="xl:col-span-2 space-y-6">

      <!-- Upload PDF -->
      <div class="card">
        <h2 class="text-base font-semibold text-gray-800 mb-4">Upload Lecture Notes (PDF)</h2>
        <form method="POST" action="/lecturer/upload-pdf" enctype="multipart/form-data" class="space-y-3">
          <input type="hidden" name="module_id" value="<%= module.id %>" />
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="form-label">Topic Name</label>
              <input type="text" name="topic_name" required class="form-input" placeholder="e.g. Arrays and Sorting" />
            </div>
            <div>
              <label class="form-label">PDF File</label>
              <input type="file" name="pdf" accept="application/pdf" required class="form-input text-sm py-1.5" />
            </div>
          </div>
          <button type="submit" class="btn-primary">Upload PDF</button>
        </form>
      </div>

      <!-- Uploaded PDFs -->
      <div class="card">
        <h2 class="text-base font-semibold text-gray-800 mb-4">Lecture Notes (<%= pdfs.length %>)</h2>
        <% if (!pdfs.length) { %>
          <p class="text-gray-400 text-sm text-center py-6">No lecture notes uploaded yet.</p>
        <% } else { %>
        <div class="space-y-2">
          <% pdfs.forEach(p => { %>
          <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
            <div class="flex items-center gap-3 min-w-0">
              <span class="text-red-500 text-xl flex-shrink-0">📄</span>
              <div class="min-w-0">
                <p class="text-sm font-medium text-gray-700 truncate"><%= p.topic_name %></p>
                <p class="text-xs text-gray-400 truncate"><%= p.file_name %> · <%= p.file_size ? Math.round(p.file_size/1024) + ' KB' : '' %></p>
              </div>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <a href="<%= p.file_url %>" target="_blank" class="text-xs text-blue-600 hover:underline">Download</a>
              <a href="/lecturer/edit-pdf/<%= p.id %>" class="text-xs text-gray-500 hover:underline">Edit</a>
              <form method="POST" action="/lecturer/edit-pdf/<%= p.id %>?_method=DELETE"
                    onsubmit="return confirm('Delete this note?')">
                <button type="submit" class="text-xs text-red-500 hover:underline">Delete</button>
              </form>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>

      <!-- Class Tests -->
      <div class="card">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-base font-semibold text-gray-800">Class Tests (<%= classTests.length %>)</h2>
        </div>

        <!-- Create form -->
        <details class="mb-4" <%= classTests.length === 0 ? 'open' : '' %>>
          <summary class="cursor-pointer text-sm text-primary-600 font-medium hover:underline select-none">+ Add Class Test</summary>
          <form method="POST" action="/lecturer/class-tests" class="mt-4 space-y-3 bg-gray-50 rounded-xl p-4">
            <input type="hidden" name="module_id" value="<%= module.id %>" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="form-label">Test Title <span class="text-red-500">*</span></label>
                <input type="text" name="title" required class="form-input" placeholder="e.g. Class Test 1" />
              </div>
              <div>
                <label class="form-label">Total Marks <span class="text-red-500">*</span></label>
                <input type="number" name="total_marks" required min="1" step="0.5" value="100" class="form-input" />
              </div>
              <div>
                <label class="form-label">Link to Lecture Notes <span class="text-red-500">*</span></label>
                <select name="pdf_note_id" required class="form-input">
                  <option value="" disabled selected>— select notes —</option>
                  <% pdfs.forEach(p => { %>
                    <option value="<%= p.id %>"><%= p.topic_name %></option>
                  <% }) %>
                </select>
              </div>
              <div>
                <label class="form-label">Test Date (optional)</label>
                <input type="date" name="test_date" class="form-input" />
              </div>
            </div>
            <button type="submit" class="btn-primary text-sm">Create Class Test</button>
          </form>
        </details>

        <% if (!classTests.length) { %>
          <p class="text-gray-400 text-sm text-center py-4">No class tests yet.</p>
        <% } else { %>
        <div class="space-y-2">
          <% classTests.forEach(ct => { %>
          <a href="/lecturer/class-tests/<%= ct.id %>"
             class="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-primary-50 hover:border-primary-200 border border-transparent transition-all group">
            <div class="min-w-0">
              <p class="text-sm font-semibold text-gray-800 group-hover:text-primary-700"><%= ct.title %></p>
              <p class="text-xs text-gray-400">📄 <%= ct.pdf_topic %> · Out of <%= ct.total_marks %><% if (ct.test_date) { %> · <%= new Date(ct.test_date).toLocaleDateString('en-GB') %><% } %></p>
            </div>
            <div class="flex items-center gap-3 flex-shrink-0 ml-3">
              <span class="text-xs text-gray-400"><%= ct.marked_count %> marked</span>
              <svg class="w-4 h-4 text-gray-300 group-hover:text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
          <% }) %>
        </div>
        <% } %>
      </div>

      <!-- Announcements -->
      <div class="card">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-base font-semibold text-gray-800">Announcements (<%= announcements.length %>)</h2>
          <a href="/lecturer/announcements/create?moduleId=<%= module.id %>" class="btn-secondary text-xs">+ Post</a>
        </div>
        <% if (!announcements.length) { %>
          <p class="text-gray-400 text-sm text-center py-4">No announcements yet.</p>
        <% } else { %>
        <div class="space-y-3">
          <% announcements.forEach(a => { %>
          <div class="p-3 rounded-lg border <%= a.is_pinned ? 'border-amber-200 bg-amber-50' : 'border-gray-100 bg-gray-50' %>">
            <div class="flex items-start justify-between gap-2">
              <div>
                <% if (a.is_pinned) { %><span class="text-xs text-amber-600 font-medium">📌 Pinned</span><% } %>
                <p class="text-sm font-semibold text-gray-800"><%= a.title %></p>
                <p class="text-xs text-gray-500 mt-0.5"><%= new Date(a.created_at).toLocaleDateString() %></p>
                <p class="text-sm text-gray-600 mt-1 whitespace-pre-line"><%= a.content %></p>
              </div>
              <form method="POST" action="/lecturer/announcements/<%= a.id %>?_method=DELETE"
                    onsubmit="return confirm('Delete this announcement?')">
                <button type="submit" class="text-gray-300 hover:text-red-500 text-xs">✕</button>
              </form>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Right: Chat -->
    <div class="card flex flex-col h-[600px]">
      <h2 class="text-base font-semibold text-gray-800 mb-3">Module Chat</h2>

      <div id="chat-messages" class="flex-1 overflow-y-auto space-y-3 pr-1 mb-3">
        <% if (!messages.length) { %>
          <p class="text-gray-400 text-sm text-center py-6">No messages yet. Start the conversation!</p>
        <% } %>
        <% messages.forEach(msg => { %>
        <div class="<%= msg.user_id === user.id ? 'text-right' : 'text-left' %>">
          <div class="inline-block max-w-[90%]">
            <% if (msg.user_id !== user.id) { %>
              <p class="text-xs text-gray-400 mb-0.5"><%= msg.name %> · <span class="badge <%= msg.role === 'lecturer' ? 'bg-blue-100 text-blue-700' : msg.role === 'student' ? 'bg-green-100 text-green-700' : 'bg-purple-100 text-purple-700' %>"><%= msg.role %></span></p>
            <% } %>
            <div class="px-3 py-2 rounded-xl text-sm <%= msg.user_id === user.id ? 'bg-primary-600 text-white' : 'bg-gray-100 text-gray-700' %>">
              <%= msg.message %>
            </div>
            <p class="text-xs text-gray-300 mt-0.5">
              <%= new Date(msg.created_at).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) %>
            </p>
          </div>
        </div>
        <% }) %>
      </div>

      <form method="POST" action="/lecturer/modules/<%= module.id %>/messages" class="flex gap-2">
        <input type="text" name="message" required class="form-input flex-1 text-sm" placeholder="Type a message…" maxlength="1000" />
        <button type="submit" class="btn-primary px-3">Send</button>
      </form>
    </div>
  </div>
</div>

<script>
  // Scroll chat to bottom
  const chat = document.getElementById('chat-messages');
  if (chat) chat.scrollTop = chat.scrollHeight;

  // Auto-refresh chat every 10 seconds
  setTimeout(() => location.reload(), 10000);
</script>

<%- include('../partials/footer') %>
