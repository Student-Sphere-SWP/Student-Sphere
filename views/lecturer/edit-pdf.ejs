<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div style="max-width:600px;margin:0 auto;">
  <div style="margin-bottom:24px;">
    <a href="/lecturer/modules/<%= pdf.module_id %>" style="color:#a78bfa;font-size:13px;font-weight:600;text-decoration:none;">← Back to Module</a>
    <h1 style="font-size:26px;font-weight:800;color:#f8fafc;margin:8px 0 0 0;letter-spacing:-0.5px;">Edit Lecture Note</h1>
  </div>

  <div class="card space-y-5">
    <div style="display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:14px;border:1px solid rgba(255,255,255,0.08);background:rgba(20,16,38,0.6);">
      <span class="text-2xl">📄</span>
      <div>
        <p class="text-sm font-medium text-gray-700"><%= pdf.file_name %></p>
        <p class="text-xs text-gray-400">Module: <%= pdf.module_name %></p>
      </div>
    </div>

    <form method="POST" action="/lecturer/edit-pdf/<%= pdf.id %>?_method=PUT" class="space-y-4">
      <div>
        <label class="form-label">Topic Name</label>
        <input type="text" name="topic_name" value="<%= pdf.topic_name %>" required
               class="form-input" maxlength="255" />
      </div>
      <div class="flex justify-end gap-3">
        <a href="/lecturer/modules/<%= pdf.module_id %>" class="btn-secondary">Cancel</a>
        <button type="submit" class="btn-primary">Update Topic</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>