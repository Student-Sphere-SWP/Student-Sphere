<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div style="max-width:1100px;margin:0 auto;">

  <!-- Header -->
  <div style="margin-bottom:24px;">
    <h1 style="font-size:26px;font-weight:800;color:#f8fafc;margin:0 0 4px 0;letter-spacing:-0.5px;">Analytics Overview</h1>
    <p style="color:#64748b;font-size:14px;margin:0;">Across all <%= moduleCount %> of your modules</p>
  </div>

  <!-- Overall stat cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4" style="margin-bottom:28px;">
    <div class="card text-center" style="position:relative;overflow:hidden;">
      <div style="position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#818cf8,#6366f1);"></div>
      <p style="font-size:40px;font-weight:800;color:#f8fafc;margin:12px 0 6px;letter-spacing:-1px;"><%= overall.totalStudents %></p>
      <p style="font-size:12px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1.5px;margin:0;">Total Students</p>
    </div>
    <div class="card text-center" style="position:relative;overflow:hidden;">
      <div style="position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#a78bfa,#7c3aed);"></div>
      <p style="font-size:40px;font-weight:800;color:#a78bfa;margin:12px 0 6px;letter-spacing:-1px;"><%= overall.totalAttempts %></p>
      <p style="font-size:12px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1.5px;margin:0;">Quiz Attempts</p>
    </div>
    <div class="card text-center" style="position:relative;overflow:hidden;">
      <div style="position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#34d399,#10b981);"></div>
      <% const avg = overall.avgScore ? parseFloat(overall.avgScore).toFixed(1) : null; %>
      <p style="font-size:40px;font-weight:800;color:<%= avg && avg >= 70 ? '#22c55e' : avg && avg >= 50 ? '#eab308' : avg ? '#ef4444' : '#64748b' %>;margin:12px 0 6px;letter-spacing:-1px;">
        <%= avg ? avg + '%' : '—' %>
      </p>
      <p style="font-size:12px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:1.5px;margin:0;">Avg Quiz Score</p>
    </div>
  </div>

  <!-- Per-module breakdown -->
  <div class="card" style="margin-bottom:24px;">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
      <div style="width:4px;height:24px;background:linear-gradient(180deg,#c4b5fd,#7c3aed);border-radius:2px;"></div>
      <h2 style="font-size:16px;font-weight:700;color:#f8fafc;margin:0;">Module Breakdown</h2>
    </div>
    <% if (!moduleStats.length) { %>
      <div style="text-align:center;padding:40px 20px;">
        <p style="color:#94a3b8;font-size:15px;font-weight:600;">No modules assigned yet.</p>
      </div>
    <% } else { %>
    <div class="space-y-3">
      <% moduleStats.forEach(m => { %>
      <%
        const mAvg = m.avg_score ? parseFloat(m.avg_score) : null;
        const barColor = mAvg === null ? '#475569' : mAvg >= 70 ? '#22c55e' : mAvg >= 50 ? '#eab308' : '#ef4444';
      %>
      <div style="display:flex;align-items:center;gap:16px;padding:14px 16px;background:rgba(20,16,38,0.5);border:1px solid rgba(255,255,255,0.07);border-radius:14px;">
        <div style="width:10px;height:10px;border-radius:50%;background:<%= m.colour %>;flex-shrink:0;box-shadow:0 0 8px <%= m.colour %>80;"></div>
        <div style="flex:1;min-width:0;">
          <div style="display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:6px;">
            <p style="font-size:14px;font-weight:600;color:#f1f5f9;margin:0;truncate;"><%= m.module_name %></p>
            <span style="font-size:11px;color:#64748b;flex-shrink:0;"><%= m.module_code %></span>
          </div>
          <div style="display:flex;align-items:center;gap:12px;">
            <div style="flex:1;height:6px;background:rgba(255,255,255,0.08);border-radius:9999px;overflow:hidden;">
              <div style="height:100%;border-radius:9999px;width:<%= mAvg || 0 %>%;background:<%= barColor %>;transition:width 0.6s ease;"></div>
            </div>
            <span style="font-size:13px;font-weight:700;color:<%= barColor %>;min-width:38px;text-align:right;">
              <%= mAvg !== null ? mAvg.toFixed(0) + '%' : '—' %>
            </span>
          </div>
        </div>
        <div style="display:flex;gap:16px;flex-shrink:0;">
          <div style="text-align:center;">
            <p style="font-size:16px;font-weight:700;color:#f8fafc;margin:0;"><%= m.student_count %></p>
            <p style="font-size:10px;color:#64748b;margin:1px 0 0 0;">students</p>
          </div>
          <div style="text-align:center;">
            <p style="font-size:16px;font-weight:700;color:#a78bfa;margin:0;"><%= m.attempt_count %></p>
            <p style="font-size:10px;color:#64748b;margin:1px 0 0 0;">attempts</p>
          </div>
        </div>
        <a href="/lecturer/analytics/<%= m.id %>" style="color:#a78bfa;font-size:12px;font-weight:600;text-decoration:none;flex-shrink:0;padding:6px 12px;background:rgba(139,92,246,0.12);border:1px solid rgba(139,92,246,0.25);border-radius:8px;">Details →</a>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>

  <!-- Recent quiz activity -->
  <div class="card">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
      <div style="width:4px;height:24px;background:linear-gradient(180deg,#93c5fd,#2563eb);border-radius:2px;"></div>
      <h2 style="font-size:16px;font-weight:700;color:#f8fafc;margin:0;">Recent Quiz Activity</h2>
    </div>
    <% if (!recentScores.length) { %>
      <div style="text-align:center;padding:40px 20px;">
        <p style="color:#94a3b8;font-size:15px;font-weight:600;">No quiz attempts yet across your modules.</p>
      </div>
    <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr style="border-bottom:1px solid rgba(255,255,255,0.08);">
            <th class="text-left py-2 px-3 text-xs font-semibold uppercase tracking-wider" style="color:#64748b;">Student</th>
            <th class="text-left py-2 px-3 text-xs font-semibold uppercase tracking-wider" style="color:#64748b;">Module</th>
            <th class="text-left py-2 px-3 text-xs font-semibold uppercase tracking-wider" style="color:#64748b;">Topic</th>
            <th class="text-center py-2 px-3 text-xs font-semibold uppercase tracking-wider" style="color:#64748b;">Score</th>
            <th class="text-center py-2 px-3 text-xs font-semibold uppercase tracking-wider" style="color:#64748b;">Date</th>
          </tr>
        </thead>
        <tbody>
          <% recentScores.forEach(r => { %>
          <% const sc = parseFloat(r.score_percentage); %>
          <tr style="border-bottom:1px solid rgba(255,255,255,0.05);">
            <td class="py-3 px-3 font-medium" style="color:#f1f5f9;"><%= r.student_name %></td>
            <td class="py-3 px-3" style="color:#94a3b8;font-size:12px;"><%= r.module_name %></td>
            <td class="py-3 px-3" style="color:#94a3b8;"><%= r.topic_name %></td>
            <td class="py-3 px-3 text-center">
              <span style="font-size:12px;font-weight:700;padding:2px 10px;border-radius:20px;
                background:<%= sc >= 70 ? 'rgba(34,197,94,0.15)' : sc >= 50 ? 'rgba(234,179,8,0.15)' : 'rgba(239,68,68,0.15)' %>;
                color:<%= sc >= 70 ? '#22c55e' : sc >= 50 ? '#eab308' : '#ef4444' %>;">
                <%= sc.toFixed(0) %>%
              </span>
            </td>
            <td class="py-3 px-3 text-center" style="color:#64748b;font-size:12px;">
              <%= new Date(r.attempted_at).toLocaleDateString('en-GB', {day:'numeric',month:'short',year:'numeric'}) %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

</div>

<%- include('../partials/footer') %>