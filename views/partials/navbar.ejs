<%
// Determine sidebar links based on role
const role = user ? user.role : null;
const links = {
  admin: [
    { href: '/admin/dashboard',   icon: '🏠', label: 'Dashboard' },
    { href: '/admin/users',       icon: '👥', label: 'Users' },
    { href: '/admin/modules',     icon: '📚', label: 'Modules' },
    { href: '/admin/enrollments', icon: '📋', label: 'Enrollments' },
    { href: '/admin/analytics',   icon: '📊', label: 'Analytics' },
    { href: '/admin/profile',     icon: '👤', label: 'My Profile' }
  ],
  lecturer: [
    { href: '/lecturer/dashboard',            icon: '🏠', label: 'Dashboard' },
    { href: '/lecturer/announcements/create', icon: '📢', label: 'Post Announcement' },
    { href: '/lecturer/create-quiz',          icon: '📝', label: 'Create Quiz' },
    { href: '/lecturer/analytics',            icon: '📊', label: 'Analytics' },
    { href: '/lecturer/profile',              icon: '👤', label: 'My Profile' }
  ],
  student: [
    { href: '/student/dashboard',      icon: '🏠', label: 'Dashboard' },
    { href: '/student/modules',        icon: '📚', label: 'Browse Modules' },
    { href: '/student/improvement',    icon: '📈', label: 'My Improvement' },
    { href: '/student/leaderboard',    icon: '🏆', label: 'Leaderboard' },
    { href: '/student/peer-sessions',  icon: '👥', label: 'Study Sessions' },
    { href: '/student/tutors',         icon: '🎓', label: 'Tutors' },
    { href: '/student/sessions',       icon: '📅', label: 'Mentor Sessions' },
    { href: '/social/friends',         icon: '🤝', label: 'Friends' },
    { href: '/social/messages',        icon: '💬', label: 'Messages' },
    { href: '/social/notifications',   icon: '🔔', label: 'Notifications' },
    { href: '/student/profile',        icon: '👤', label: 'My Profile' }
  ],
  mentor: [
    { href: '/mentor/dashboard', icon: '🏠', label: 'Dashboard' },
    { href: '/mentor/sessions',  icon: '📅', label: 'My Sessions' },
    { href: '/mentor/my-notes',  icon: '📄', label: 'My Notes' },
    { href: '/mentor/profile',   icon: '👤', label: 'My Profile' }
  ]
};
const roleLinks = role ? (links[role] || []) : [];
const roleBadgeColor = {
  admin: 'bg-red-100 text-red-700',
  lecturer: 'bg-blue-100 text-blue-700',
  student: 'bg-green-100 text-green-700',
  mentor: 'bg-purple-100 text-purple-700'
};
%>

<div class="flex h-screen overflow-hidden" style="background: linear-gradient(160deg, rgba(10,8,25,0.97) 0%, rgba(18,12,32,0.97) 30%, rgba(10,20,32,0.97) 70%, rgba(8,10,20,0.97) 100%), url('/images/login_bg.jpg'); background-size: cover; background-position: center; background-attachment: fixed;">
  <!-- Sidebar -->
  <aside class="hidden lg:flex flex-col w-64 flex-shrink-0" style="background: rgba(12,10,24,0.92); border-right: 1px solid rgba(255,255,255,0.08);">
    <!-- Logo -->
    <div style="display:flex; align-items:center; gap:12px; padding:0 24px; height:64px; border-bottom:1px solid rgba(255,255,255,0.08);">
      <div style="width:32px;height:32px;background:linear-gradient(135deg,#7c3aed,#6d28d9);border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:14px;box-shadow:0 4px 14px rgba(124,58,237,0.4);">S²</div>
      <span style="font-weight:800;color:#f8fafc;font-size:17px;letter-spacing:-0.3px;">Student Sphere</span>
    </div>

    <!-- Nav links -->
    <nav style="flex:1;overflow-y:auto;padding:16px 12px;" class="space-y-0.5">
      <% roleLinks.forEach(link => { %>
        <a href="<%= link.href %>"
           style="display:flex;align-items:center;gap:12px;padding:10px 16px;border-radius:12px;font-size:14px;font-weight:600;color:#cbd5e1;text-decoration:none;transition:all 0.15s;"
           onmouseover="this.style.background='rgba(139,92,246,0.15)';this.style.color='#ddd6fe';"
           onmouseout="this.style.background='transparent';this.style.color='#cbd5e1';">
          <span style="font-size:16px;"><%= link.icon %></span>
          <span><%= link.label %></span>
        </a>
      <% }) %>
    </nav>

    <!-- User section -->
    <% if (user) { %>
    <div style="border-top:1px solid rgba(255,255,255,0.08);padding:16px;">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
        <% if (user.profile_picture) { %>
          <img src="<%= user.profile_picture %>" alt="<%= user.name %>" style="width:36px;height:36px;border-radius:50%;object-fit:cover;border:2px solid rgba(139,92,246,0.4);" />
        <% } else { %>
          <div style="width:36px;height:36px;border-radius:50%;background:rgba(139,92,246,0.25);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;color:#c4b5fd;border:2px solid rgba(139,92,246,0.3);">
            <%= user.name.charAt(0).toUpperCase() %>
          </div>
        <% } %>
        <div style="flex:1;min-width:0;">
          <p style="font-size:13px;font-weight:700;color:#f1f5f9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:0;"><%= user.name %></p>
          <span style="font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px;letter-spacing:0.3px;
            <%= user.role === 'admin' ? 'background:rgba(239,68,68,0.2);color:#fca5a5;' :
               user.role === 'lecturer' ? 'background:rgba(59,130,246,0.2);color:#93c5fd;' :
               user.role === 'student' ? 'background:rgba(16,185,129,0.2);color:#6ee7b7;' :
               'background:rgba(139,92,246,0.2);color:#ddd6fe;' %>">
            <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %>
          </span>
        </div>
      </div>
      <a href="/logout" style="display:flex;align-items:center;gap:8px;width:100%;padding:9px 14px;font-size:13px;font-weight:600;color:#94a3b8;text-decoration:none;border-radius:10px;transition:all 0.15s;"
         onmouseover="this.style.background='rgba(239,68,68,0.12)';this.style.color='#fca5a5';"
         onmouseout="this.style.background='transparent';this.style.color='#94a3b8';">
        <svg style="width:14px;height:14px;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
        Sign out
      </a>
    </div>
    <% } %>
  </aside>

  <!-- Main content area -->
  <div class="flex-1 flex flex-col overflow-hidden">
    <!-- Mobile top bar -->
    <header class="lg:hidden flex items-center justify-between px-4 h-14" style="background:rgba(12,10,24,0.95);border-bottom:1px solid rgba(255,255,255,0.08);">
      <div style="display:flex;align-items:center;gap:8px;">
        <div style="width:28px;height:28px;background:linear-gradient(135deg,#7c3aed,#6d28d9);border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:12px;">S²</div>
        <span style="font-weight:800;color:#f8fafc;font-size:15px;">Student Sphere</span>
      </div>
      <button id="mobile-menu-btn" style="padding:8px;border-radius:8px;background:transparent;border:none;cursor:pointer;">
        <svg style="width:20px;height:20px;color:#94a3b8;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </header>

    <!-- Mobile menu overlay -->
    <div id="mobile-menu" class="lg:hidden hidden fixed inset-0 z-50">
      <div class="absolute inset-0 bg-black bg-opacity-60" id="mobile-menu-overlay"></div>
      <div class="absolute left-0 top-0 bottom-0 w-64 flex flex-col" style="background:rgba(12,10,24,0.97);border-right:1px solid rgba(255,255,255,0.1);">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:0 20px;height:56px;border-bottom:1px solid rgba(255,255,255,0.08);">
          <span style="font-weight:800;color:#f8fafc;font-size:15px;">Menu</span>
          <button id="mobile-menu-close" style="background:transparent;border:none;cursor:pointer;color:#94a3b8;font-size:18px;padding:4px;">✕</button>
        </div>
        <nav style="flex:1;overflow-y:auto;padding:12px;" class="space-y-0.5">
          <% roleLinks.forEach(link => { %>
            <a href="<%= link.href %>" style="display:flex;align-items:center;gap:12px;padding:10px 16px;border-radius:10px;font-size:14px;font-weight:600;color:#cbd5e1;text-decoration:none;">
              <span><%= link.icon %></span><span><%= link.label %></span>
            </a>
          <% }) %>
        </nav>
        <% if (user) { %>
        <div style="border-top:1px solid rgba(255,255,255,0.08);padding:16px;">
          <a href="/logout" style="display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:#f87171;text-decoration:none;padding:8px 12px;border-radius:8px;">
            Sign out
          </a>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Page content -->
    <main class="flex-1 overflow-y-auto p-6" style="font-family:'Inter','SF Pro Display',system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased;color:#f1f5f9;">
