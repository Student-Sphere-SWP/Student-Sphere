<% if (typeof success !== 'undefined' && success) { %>
<div style="margin-bottom:16px;display:flex;align-items:flex-start;gap:12px;background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.25);border-radius:12px;padding:12px 16px;font-size:14px;color:#6ee7b7;">
  <span style="margin-top:2px;">✓</span>
  <span><%= success %></span>
</div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
<div style="margin-bottom:16px;display:flex;align-items:flex-start;gap:12px;background:rgba(239,68,68,0.12);border:1px solid rgba(239,68,68,0.25);border-radius:12px;padding:12px 16px;font-size:14px;color:#fca5a5;">
  <span style="margin-top:2px;">✕</span>
  <span><%= error %></span>
</div>
<% } %>

<% if (typeof info !== 'undefined' && info) { %>
<div style="margin-bottom:16px;display:flex;align-items:flex-start;gap:12px;background:rgba(99,102,241,0.12);border:1px solid rgba(99,102,241,0.25);border-radius:12px;padding:12px 16px;font-size:14px;color:#a5b4fc;">
  <span style="margin-top:2px;">ℹ</span>
  <span><%= info %></span>
</div>
<% } %>