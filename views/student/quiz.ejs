<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div style="max-width:900px;margin:0 auto;">
  <div>
    <a href="/student/modules/<%= moduleId %>" style="color:#a78bfa;font-size:13px;font-weight:600;text-decoration:none;">← Back to Module</a>
    <h1 style="font-size:26px;font-weight:800;color:#f8fafc;margin:8px 0 6px 0;letter-spacing:-0.5px;">AI Quiz</h1>
    <p style="color:#64748b;font-size:14px;margin:0;">Topic: <strong style="color:#94a3b8;"><%= topicName %></strong> · <%= questions.length %> questions</p>
  </div>

  <form method="POST" action="/student/submit-quiz" id="quiz-form" style="margin-top:24px;">
    <input type="hidden" name="questions_json" id="questions_json" />
    <input type="hidden" name="pdf_note_id" value="<%= pdfNoteId %>" />
    <input type="hidden" name="module_id" value="<%= moduleId %>" />
    <input type="hidden" name="topic_name" value="<%= topicName %>" />

    <div class="space-y-4">
      <% questions.forEach((q, idx) => { %>
      <div class="card">
        <p class="text-sm font-semibold text-gray-800 mb-3">
          <span class="text-primary-600 mr-1"><%= idx + 1 %>.</span> <%= q.question %>
        </p>
        <div class="space-y-2">
          <% ['A','B','C','D'].forEach(letter => { %>
          <% if (q.options && q.options[letter]) { %>
          <label class="flex items-center gap-3 p-2.5 rounded-lg border border-gray-200 hover:border-primary-300 hover:bg-primary-50 cursor-pointer transition-colors">
            <input type="radio" name="answer_<%= idx %>" value="<%= letter %>" required
                   class="text-primary-600 focus:ring-primary-500" />
            <span class="text-sm text-gray-700"><strong class="text-primary-600 mr-1"><%= letter %>.</strong> <%= q.options[letter] %></span>
          </label>
          <% } %>
          <% }) %>
        </div>
      </div>
      <% }) %>
    </div>

    <div class="flex justify-end mt-6">
      <button type="submit" id="submit-btn" class="btn-primary px-8">Submit Quiz</button>
    </div>
  </form>
</div>

<!-- Loading overlay -->
<div id="loading-overlay" class="hidden fixed inset-0 z-50 flex flex-col items-center justify-center" style="background:rgba(12,10,24,0.92);backdrop-filter:blur(12px);">
  <div class="flex flex-col items-center gap-4">
    <div style="width:56px;height:56px;border:3px solid rgba(139,92,246,0.2);border-top:3px solid #a78bfa;border-radius:50%;animation:spin 0.8s linear infinite;"></div>
    <style>@keyframes spin{to{transform:rotate(360deg)}}</style>
    <p id="loading-msg" style="color:#f8fafc;font-weight:600;font-size:18px;">Submitting your quiz...</p>
    <p style="color:#64748b;font-size:14px;">Please wait</p>
  </div>
</div>

<script>
  const QUESTIONS = <%- JSON.stringify(questions) %>;

  document.getElementById('quiz-form').addEventListener('submit', function() {
    document.getElementById('questions_json').value = JSON.stringify(QUESTIONS);
    document.getElementById('submit-btn').disabled = true;
    document.getElementById('loading-overlay').classList.remove('hidden');
  });
</script>

<%- include('../partials/footer') %>