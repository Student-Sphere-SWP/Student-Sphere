<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div style="max-width:900px;margin:0 auto;">
  <div>
    <a href="/student/modules/<%= quiz.module_id %>" style="color:#a78bfa;font-size:13px;font-weight:600;text-decoration:none;">← Back to Module</a>
    <h1 style="font-size:26px;font-weight:800;color:#f8fafc;margin:8px 0 6px 0;letter-spacing:-0.5px;">Practice Quiz</h1>
    <p style="color:#64748b;font-size:14px;margin:0;">Topic: <strong style="color:#94a3b8;"><%= quiz.topic_name %></strong> · <%= questions.length %> questions</p>
  </div>

  <form method="POST" action="/student/manual-quiz/<%= quiz.id %>/submit" style="margin-top:24px;">
    <div class="space-y-4">
      <% questions.forEach((q, idx) => { %>
      <div class="card">
        <p class="text-sm font-semibold text-gray-800 mb-3">
          <span class="text-primary-600 mr-1"><%= idx + 1 %>.</span> <%= q.question_text %>
        </p>
        <div class="space-y-2">
          <% ['A','B','C','D'].forEach(letter => { %>
          <% const optKey = 'option_' + letter.toLowerCase(); %>
          <% if (q[optKey]) { %>
          <label class="flex items-center gap-3 p-2.5 rounded-lg border border-gray-200 hover:border-primary-300 hover:bg-primary-50 cursor-pointer transition-colors">
            <input type="radio" name="answer_<%= q.id %>" value="<%= letter %>" required
                   class="text-primary-600 focus:ring-primary-500" />
            <span class="text-sm text-gray-700"><strong class="text-primary-600 mr-1"><%= letter %>.</strong> <%= q[optKey] %></span>
          </label>
          <% } %>
          <% }) %>
        </div>
      </div>
      <% }) %>
    </div>

    <div class="flex justify-end mt-6">
      <button type="submit" class="btn-primary px-8">Submit Quiz</button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>