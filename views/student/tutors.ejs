<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>

<div style="max-width:1200px;margin:0 auto;">
  <h1 style="font-size:26px;font-weight:800;color:#f8fafc;margin:0 0 6px 0;letter-spacing:-0.5px;">Find a Tutor</h1>
  <p style="color:#64748b;font-size:14px;margin:0 0 24px 0;">Mentors for your enrolled modules.</p>

  <% if (!tutors.length) { %>
    <div style="text-align:center;padding:60px 20px;">
      <span style="font-size:48px;display:block;margin-bottom:16px;">🎓</span>
      <p style="color:#94a3b8;font-size:16px;font-weight:600;">No tutors available for your current modules.</p>
    </div>
  <% } else { %>
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
    <% tutors.forEach(t => { %>
    <a href="/student/tutors/<%= t.id %>" class="card group hover:shadow-md transition-shadow flex items-start gap-4 no-underline">
      <% if (t.profile_picture) { %>
        <img src="<%= t.profile_picture %>" alt="" class="w-14 h-14 rounded-full object-cover flex-shrink-0" />
      <% } else { %>
        <div class="w-14 h-14 rounded-full bg-purple-100 flex items-center justify-center text-xl font-bold text-purple-600 flex-shrink-0">
          <%= t.name.charAt(0).toUpperCase() %>
        </div>
      <% } %>
      <div class="min-w-0">
        <p class="text-sm font-semibold text-gray-800 group-hover:text-primary-600 transition-colors"><%= t.name %></p>
        <% if (t.bio) { %><p class="text-xs text-gray-400 line-clamp-2 mt-0.5"><%= t.bio %></p><% } %>
        <%
          const moduleList = Array.isArray(t.modules)
            ? t.modules
            : (typeof t.modules === 'string'
              ? t.modules.split(',').map(s => s.trim()).filter(Boolean)
              : []);
        %>
        <div class="flex flex-wrap gap-1 mt-2">
          <% moduleList.forEach(m => { %>
          <span class="badge bg-purple-100 text-purple-700"><%= m %></span>
          <% }) %>
        </div>
        <div class="flex items-center gap-1 mt-2">
          <% const avg = parseFloat(t.avg_rating) || 0; %>
          <% for (let i = 1; i <= 5; i++) { %>
            <span class="text-sm <%= i <= Math.round(avg) ? 'text-yellow-400' : 'text-gray-200' %>">★</span>
          <% } %>
          <span class="text-xs text-gray-400 ml-1">
            <%= avg ? avg.toFixed(1) : 'No ratings' %>
            <% if (t.rating_count) { %> (<%= t.rating_count %> review<%= t.rating_count !== 1 ? 's' : '' %>)<% } %>
          </span>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
  <% } %>
</div>

<%- include('../partials/footer') %>