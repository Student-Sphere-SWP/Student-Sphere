<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div style="max-width:1200px;margin:0 auto;">

  <!-- Header -->
  <div style="position:relative;background:rgba(15,12,30,0.75);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,0.12);border-radius:24px;padding:32px 40px;margin-bottom:24px;overflow:hidden;">
    <div style="position:absolute;top:-80px;right:-40px;width:200px;height:200px;background:radial-gradient(circle,rgba(139,92,246,0.1) 0%,transparent 70%);border-radius:50%;"></div>
    <div style="position:absolute;bottom:-60px;left:20%;width:160px;height:160px;background:radial-gradient(circle,rgba(59,130,246,0.06) 0%,transparent 70%);border-radius:50%;"></div>
    <div style="position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:20px;">
      <div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
          <div style="width:10px;height:10px;background:#a78bfa;border-radius:50%;box-shadow:0 0 14px rgba(167,139,250,0.6);"></div>
          <p style="font-size:13px;font-weight:700;color:#c4b5fd;text-transform:uppercase;letter-spacing:2.5px;margin:0;">Student Portal</p>
        </div>
        <h1 style="font-size:38px;font-weight:800;color:#ffffff;margin:0;letter-spacing:-1px;line-height:1.1;">Welcome back</h1>
        <p style="font-size:20px;color:#e2e8f0;margin:6px 0 0 0;font-weight:600;"><%= user.name %></p>
        <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:20px;">
          <a href="/student/modules" style="background:linear-gradient(135deg,#7c3aed,#6d28d9);color:#fff;padding:10px 20px;border-radius:10px;font-size:13px;font-weight:700;text-decoration:none;box-shadow:0 4px 16px rgba(124,58,237,0.4);">📚 Browse Modules</a>
          <a href="/student/improvement" style="background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);color:#f1f5f9;padding:10px 20px;border-radius:10px;font-size:13px;font-weight:700;text-decoration:none;">📈 My Improvement</a>
          <a href="/student/adaptive-quiz" style="background:rgba(16,185,129,0.2);border:1px solid rgba(16,185,129,0.3);color:#6ee7b7;padding:10px 20px;border-radius:10px;font-size:13px;font-weight:700;text-decoration:none;">🧠 Adaptive Quiz</a>
        </div>
      </div>
      <!-- Stat pills -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;min-width:220px;">
        <div style="background:rgba(139,92,246,0.15);border:1px solid rgba(139,92,246,0.25);border-radius:16px;padding:16px;text-align:center;">
          <p style="font-size:28px;font-weight:800;color:#fff;margin:0;"><%= modules.length %></p>
          <p style="font-size:11px;color:#c4b5fd;margin:4px 0 0 0;font-weight:600;">Modules</p>
        </div>
        <div style="background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.22);border-radius:16px;padding:16px;text-align:center;">
          <p style="font-size:28px;font-weight:800;color:#fff;margin:0;"><%= masteredTopics %></p>
          <p style="font-size:11px;color:#6ee7b7;margin:4px 0 0 0;font-weight:600;">Mastered</p>
        </div>
        <div style="background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.22);border-radius:16px;padding:16px;text-align:center;">
          <p style="font-size:28px;font-weight:800;color:#fff;margin:0;"><%= totalTopics %></p>
          <p style="font-size:11px;color:#93c5fd;margin:4px 0 0 0;font-weight:600;">Practised</p>
        </div>
        <div style="background:rgba(245,158,11,0.12);border:1px solid rgba(245,158,11,0.22);border-radius:16px;padding:16px;text-align:center;">
          <p style="font-size:28px;font-weight:800;color:#fff;margin:0;"><%= overallAvg %>%</p>
          <p style="font-size:11px;color:#fcd34d;margin:4px 0 0 0;font-weight:600;">Avg Score</p>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-5 gap-6" style="margin-bottom:24px;">

    <!-- Enrolled modules -->
    <div class="lg:col-span-3 card">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
        <div style="display:flex;align-items:center;gap:12px;">
          <div style="width:4px;height:24px;background:linear-gradient(180deg,#c4b5fd,#7c3aed);border-radius:2px;"></div>
          <h2 style="font-size:16px;font-weight:700;color:#f8fafc;margin:0;">My Modules</h2>
        </div>
        <a href="/student/modules" style="font-size:13px;color:#a78bfa;text-decoration:none;font-weight:600;">Browse all →</a>
      </div>
      <% if (!modules.length) { %>
        <div style="text-align:center;padding:48px 20px;">
          <p style="font-size:40px;margin-bottom:12px;">📭</p>
          <p style="color:#64748b;font-size:14px;">You haven't enrolled in any modules yet.</p>
          <a href="/student/modules" class="btn-primary" style="margin-top:16px;display:inline-flex;">Browse Modules</a>
        </div>
      <% } else { %>
      <div style="display:flex;flex-direction:column;gap:8px;">
        <% modules.forEach(m => { %>
        <a href="/student/modules/<%= m.id %>"
           style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-radius:14px;border:1px solid rgba(255,255,255,0.08);text-decoration:none;transition:background 0.15s;"
           onmouseover="this.style.background='rgba(139,92,246,0.1)';this.style.borderColor='rgba(139,92,246,0.25)';"
           onmouseout="this.style.background='transparent';this.style.borderColor='rgba(255,255,255,0.08)';">
          <div style="display:flex;align-items:center;gap:12px;min-width:0;">
            <div class="module-tile" data-colour="<%= m.colour %>" style="width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff;font-size:13px;font-weight:700;">
              <%= m.module_code ? m.module_code.slice(0,2) : m.module_name.charAt(0) %>
            </div>
            <div style="min-width:0;">
              <p style="font-size:14px;font-weight:600;color:#f1f5f9;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= m.module_name %></p>
              <p style="font-size:12px;color:#64748b;margin:3px 0 0 0;"><%= m.pdf_count %> notes · <%= m.announcement_count %> announcements</p>
            </div>
          </div>
          <svg style="width:16px;height:16px;color:#475569;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
        <% }) %>
      </div>
      <% } %>
    </div>

    <!-- Recent scores -->
    <div class="lg:col-span-2 card" style="display:flex;flex-direction:column;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
        <div style="display:flex;align-items:center;gap:12px;">
          <div style="width:4px;height:24px;background:linear-gradient(180deg,#6ee7b7,#10b981);border-radius:2px;"></div>
          <h2 style="font-size:16px;font-weight:700;color:#f8fafc;margin:0;">Recent Scores</h2>
        </div>
        <a href="/student/improvement" style="font-size:13px;color:#6ee7b7;text-decoration:none;font-weight:600;">All progress →</a>
      </div>
      <% if (!recentScores.length) { %>
        <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:32px;color:#475569;">
          <p style="font-size:32px;margin-bottom:8px;">🎯</p>
          <p style="font-size:14px;">No quizzes taken yet.<br/>Generate one from a lecture note!</p>
        </div>
      <% } else { %>
      <div style="display:flex;flex-direction:column;gap:10px;flex:1;">
        <% recentScores.forEach(s => { %>
        <%
          const pct = parseFloat(s.score_percentage) || 0;
          const barColor = pct >= 85 ? '#10b981' : pct >= 70 ? '#22c55e' : pct >= 50 ? '#f59e0b' : '#ef4444';
        %>
        <div style="padding:12px 14px;border-radius:14px;border:1px solid rgba(255,255,255,0.08);background:rgba(20,16,38,0.6);">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:8px;">
            <div style="min-width:0;">
              <p style="font-size:13px;font-weight:600;color:#f1f5f9;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= s.topic_name %></p>
              <p style="font-size:11px;color:#64748b;margin:3px 0 0 0;"><%= s.module_name %> · <%= new Date(s.attempted_at).toLocaleDateString() %></p>
            </div>
            <span style="font-size:13px;font-weight:700;color:<%= barColor %>;flex-shrink:0;"><%= pct.toFixed(0) %>%</span>
          </div>
          <div style="width:100%;height:4px;background:rgba(255,255,255,0.08);border-radius:2px;overflow:hidden;">
            <div class="score-bar" data-pct="<%= pct %>" data-color="<%= barColor %>" style="height:100%;border-radius:2px;transition:width 0.6s ease;"></div>
          </div>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>

  </div>

  <!-- Quick actions -->
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:14px;">
    <a href="/student/modules" style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:28px;background:rgba(15,12,30,0.75);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,0.1);border-radius:20px;text-decoration:none;transition:border-color 0.15s;"
       onmouseover="this.style.borderColor='rgba(139,92,246,0.4)';" onmouseout="this.style.borderColor='rgba(255,255,255,0.1)';">
      <span style="font-size:30px;">📚</span>
      <p style="font-size:14px;font-weight:600;color:#e2e8f0;margin:0;">Browse Modules</p>
    </a>
    <a href="/student/improvement" style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:28px;background:rgba(15,12,30,0.75);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,0.1);border-radius:20px;text-decoration:none;transition:border-color 0.15s;"
       onmouseover="this.style.borderColor='rgba(16,185,129,0.4)';" onmouseout="this.style.borderColor='rgba(255,255,255,0.1)';">
      <span style="font-size:30px;">📈</span>
      <p style="font-size:14px;font-weight:600;color:#e2e8f0;margin:0;">My Improvement</p>
    </a>
    <a href="/student/leaderboard" style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:28px;background:rgba(15,12,30,0.75);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,0.1);border-radius:20px;text-decoration:none;transition:border-color 0.15s;"
       onmouseover="this.style.borderColor='rgba(245,158,11,0.4)';" onmouseout="this.style.borderColor='rgba(255,255,255,0.1)';">
      <span style="font-size:30px;">🏆</span>
      <p style="font-size:14px;font-weight:600;color:#e2e8f0;margin:0;">Leaderboard</p>
    </a>
    <a href="/student/tutors" style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:28px;background:rgba(15,12,30,0.75);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,0.1);border-radius:20px;text-decoration:none;transition:border-color 0.15s;"
       onmouseover="this.style.borderColor='rgba(168,85,247,0.4)';" onmouseout="this.style.borderColor='rgba(255,255,255,0.1)';">
      <span style="font-size:30px;">🎓</span>
      <p style="font-size:14px;font-weight:600;color:#e2e8f0;margin:0;">Find a Tutor</p>
    </a>
  </div>

</div>

<script>
  document.querySelectorAll('.module-tile').forEach(el => {
    el.style.backgroundColor = el.dataset.colour;
  });
  document.querySelectorAll('.score-bar').forEach(el => {
    el.style.width = el.dataset.pct + '%';
    el.style.backgroundColor = el.dataset.color;
  });
</script>

<%- include('../partials/footer') %>
