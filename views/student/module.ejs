<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div class="space-y-6" style="max-width:1200px;margin:0 auto;">
  <!-- Header -->
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <a href="/student/dashboard" class="text-gray-400 hover:text-gray-600 text-sm">← Dashboard</a>
      <div class="flex items-center gap-2">
        <div class="w-3 h-3 rounded-full" style="background-color: <%= module.colour %>"></div>
        <h1 class="text-2xl font-bold text-gray-900"><%= module.module_name %></h1>
        <span class="badge bg-gray-100 text-gray-600"><%= module.module_code %></span>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <!-- Left col: PDFs + Announcements + Manual quizzes -->
    <div class="xl:col-span-2 space-y-6">

      <!-- Announcements (pinned first) -->
      <% const pinned = announcements.filter(a => a.is_pinned); %>
      <% const unpinned = announcements.filter(a => !a.is_pinned); %>
      <% if (announcements.length) { %>
      <div class="card">
        <h2 class="text-base font-semibold text-gray-800 mb-4">Announcements</h2>
        <div class="space-y-3">
          <% [...pinned, ...unpinned].forEach(a => { %>
          <div class="p-3 rounded-lg border <%= a.is_pinned ? 'border-amber-200 bg-amber-50' : 'border-gray-100 bg-gray-50' %>">
            <% if (a.is_pinned) { %><span class="text-xs text-amber-600 font-medium">📌 Pinned</span><% } %>
            <p class="text-sm font-semibold text-gray-800"><%= a.title %></p>
            <p class="text-xs text-gray-400 mt-0.5"><%= a.lecturer_name %> · <%= new Date(a.created_at).toLocaleDateString() %></p>
            <p class="text-sm text-gray-600 mt-2 whitespace-pre-line"><%= a.content %></p>
          </div>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- Lecture Notes + Quiz Generator -->
      <div class="card">
        <h2 class="text-base font-semibold text-gray-800 mb-4">Lecture Notes</h2>
        <% if (!pdfs.length) { %>
          <p class="text-gray-400 text-sm text-center py-6">No lecture notes have been uploaded yet.</p>
        <% } else { %>
        <div class="space-y-3">
          <% pdfs.forEach(p => { %>
          <div class="flex items-start justify-between p-3 bg-gray-50 rounded-lg gap-3">
            <div class="flex items-center gap-3 min-w-0">
              <span class="text-red-500 text-xl flex-shrink-0">📄</span>
              <div class="min-w-0">
                <p class="text-sm font-medium text-gray-700 truncate"><%= p.topic_name %></p>
                <p class="text-xs text-gray-400"><%= p.file_name %></p>
              </div>
            </div>
            <div class="flex items-center gap-3 flex-shrink-0">
              <a href="<%= p.file_url %>" target="_blank" download
                 class="text-xs text-blue-600 hover:underline whitespace-nowrap">⬇ Download</a>
              <!-- AI Quiz button -->
                    <button onclick='openQuizModal(<%- JSON.stringify(p.id) %>, <%- JSON.stringify(p.topic_name) %>)'
                      class="text-xs text-primary-600 hover:underline whitespace-nowrap">🧠 Generate Quiz</button>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>

      <!-- Class Tests -->
      <% if (classTests.length) { %>
      <div class="card">
        <h2 class="text-base font-semibold text-gray-800 mb-4">📝 Class Tests</h2>
        <div class="space-y-2">
          <% classTests.forEach(ct => { %>
          <%
            const hasMark = ct.my_mark !== null;
            const pct = hasMark ? Math.round((parseFloat(ct.my_mark) / parseFloat(ct.total_marks)) * 100) : null;
            const scoreColor = pct === null ? 'text-gray-400'
              : pct >= 75 ? 'text-emerald-600'
              : pct >= 50 ? 'text-yellow-600'
              : 'text-red-500';
          %>
          <a href="/student/class-tests/<%= ct.id %>"
             class="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-primary-50 border border-transparent hover:border-primary-200 transition-all group">
            <div class="min-w-0">
              <p class="text-sm font-semibold text-gray-800 group-hover:text-primary-700"><%= ct.title %></p>
              <p class="text-xs text-gray-400">📄 <%= ct.pdf_topic %><% if (ct.test_date) { %> · <%= new Date(ct.test_date).toLocaleDateString('en-GB') %><% } %></p>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0 ml-3">
              <% if (hasMark) { %>
                <span class="badge <%= pct>=75?'bg-emerald-100 text-emerald-700':pct>=50?'bg-yellow-100 text-yellow-700':'bg-red-100 text-red-600' %>"><%= pct %>%</span>
              <% } else { %>
                <span class="text-xs text-gray-400">Not marked yet</span>
              <% } %>
              <svg class="w-4 h-4 text-gray-300 group-hover:text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>
          </a>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- Practice quizzes (manual) -->
      <% if (manualQuizzes.length) { %>
      <div class="card">
        <h2 class="text-base font-semibold text-gray-800 mb-4">Practice Quizzes</h2>
        <div class="space-y-2">
          <% manualQuizzes.forEach(q => { %>
          <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
            <div>
              <p class="text-sm font-medium text-gray-700"><%= q.topic_name %></p>
              <p class="text-xs text-gray-400"><%= q.question_count %> questions</p>
            </div>
            <a href="/student/manual-quiz/<%= q.id %>" class="btn-secondary text-xs">Take Quiz</a>
          </div>
          <% }) %>
        </div>
      </div>
      <% } %>
    </div>

    <!-- Right: Chat -->
    <div class="card flex flex-col" style="height: 580px;">
      <h2 class="text-base font-semibold text-gray-800 mb-3">Module Chat</h2>
      <div id="chat-messages" class="flex-1 overflow-y-auto space-y-3 pr-1 mb-3">
        <% if (!messages.length) { %>
          <p class="text-gray-400 text-sm text-center py-6">No messages yet.</p>
        <% } %>
        <% messages.forEach(msg => { %>
        <div class="<%= msg.user_id === user.id ? 'text-right' : 'text-left' %>">
          <div class="inline-block max-w-[90%]">
            <% if (msg.user_id !== user.id) { %>
              <p class="text-xs text-gray-400 mb-0.5">
                <% if (msg.profile_picture) { %>
                  <img src="<%= msg.profile_picture %>" class="inline w-4 h-4 rounded-full object-cover mr-1" />
                <% } %>
                <%= msg.name %>
                <span class="badge ml-1 <%= msg.role === 'lecturer' ? 'bg-blue-100 text-blue-700' : msg.role === 'student' ? 'bg-green-100 text-green-700' : 'bg-purple-100 text-purple-700' %>"><%= msg.role %></span>
              </p>
            <% } %>
            <div class="px-3 py-2 rounded-xl text-sm <%= msg.user_id === user.id ? 'bg-primary-600 text-white' : 'bg-gray-100 text-gray-700' %>">
              <%= msg.message %>
            </div>
            <p class="text-xs text-gray-300 mt-0.5">
              <%= new Date(msg.created_at).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) %>
            </p>
          </div>
        </div>
        <% }) %>
      </div>
      <form method="POST" action="/student/modules/<%= module.id %>/messages#chat" class="flex gap-2">
        <input type="text" name="message" required class="form-input flex-1 text-sm" placeholder="Type a message…" maxlength="1000" />
        <button type="submit" class="btn-primary px-3">Send</button>
      </form>
    </div>
  </div>
</div>

<!-- AI Quiz Generation Modal -->
<div id="quiz-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black bg-opacity-60" onclick="closeQuizModal()"></div>
  <div class="relative w-full max-w-sm" style="background:rgba(15,12,30,0.97);backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,0.15);border-radius:24px;padding:32px;">
    <h2 style="font-size:18px;font-weight:700;color:#f8fafc;margin:0 0 6px 0;">Generate AI Quiz</h2>
    <p style="font-size:13px;color:#94a3b8;margin:0 0 24px 0;">Topic: <strong style="color:#c4b5fd;" id="modal-topic"></strong></p>
    <form method="POST" action="/student/generate-quiz" id="quiz-gen-form">
      <input type="hidden" name="pdf_note_id" id="modal-pdf-id" />
      <div class="mb-4">
        <label class="form-label">Number of Questions</label>
        <select name="questions_count" class="form-input">
          <option value="5">5 questions</option>
          <option value="10" selected>10 questions</option>
          <option value="15">15 questions</option>
          <option value="20">20 questions</option>
        </select>
      </div>
      <p class="text-xs text-gray-400 mb-4">
        The system will extract text from the PDF and use Google Gemini AI to generate a personalised quiz.
      </p>
      <div class="flex gap-3">
        <button type="button" onclick="closeQuizModal()" class="btn-secondary flex-1 justify-center">Cancel</button>
        <button type="submit" id="gen-btn" class="btn-primary flex-1 justify-center">Generate</button>
      </div>
    </form>
  </div>
</div>

<!-- Loading overlay for quiz generation -->
<div id="quiz-loading" class="hidden fixed inset-0 z-50 flex flex-col items-center justify-center" style="background:rgba(12,10,24,0.92);backdrop-filter:blur(12px);">
  <style>@keyframes spin{to{transform:rotate(360deg)}}</style>
  <div style="display:flex;flex-direction:column;align-items:center;gap:20px;">
    <div style="width:56px;height:56px;border:3px solid rgba(139,92,246,0.2);border-top:3px solid #a78bfa;border-radius:50%;animation:spin 0.8s linear infinite;"></div>
    <p style="color:#f1f5f9;font-weight:600;font-size:18px;margin:0;">Generating your quiz with AI...</p>
    <p style="color:#64748b;font-size:14px;margin:0;">This may take up to 30 seconds</p>
  </div>
</div>

<script>
  // Scroll chat
  const chat = document.getElementById('chat-messages');
  if (chat) chat.scrollTop = chat.scrollHeight;

  // Auto-refresh every 10 seconds (cancelled if quiz generation is in progress)
  let autoRefresh = setTimeout(() => location.reload(), 10000);

  function openQuizModal(pdfId, topic) {
    document.getElementById('modal-pdf-id').value = pdfId;
    document.getElementById('modal-topic').textContent = topic;
    document.getElementById('quiz-modal').classList.remove('hidden');
  }
  function closeQuizModal() {
    document.getElementById('quiz-modal').classList.add('hidden');
  }

  // Show loading state during quiz generation
  document.getElementById('quiz-gen-form').addEventListener('submit', () => {
    clearTimeout(autoRefresh); // prevent auto-refresh from killing the request
    const btn = document.getElementById('gen-btn');
    btn.disabled = true;
    btn.textContent = 'Generating…';
    document.getElementById('quiz-loading').classList.remove('hidden');
  });
</script>

<%- include('../partials/footer') %>
