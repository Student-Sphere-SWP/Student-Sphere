<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div class="max-w-2xl mx-auto space-y-6">

  <!-- Header -->
  <div class="text-center">
    <h1 class="text-3xl font-extrabold text-gray-900">🏆 Top Achievers</h1>
    <p class="text-gray-500 mt-1 text-sm">Top 5 students by average quiz score — select a module to compare</p>
  </div>

  <!-- Module selector -->
  <div class="card">
    <form method="GET" action="/student/leaderboard" class="flex flex-wrap gap-3 items-end">
      <div class="flex-1 min-w-[200px]">
        <label class="form-label">Select Module</label>
        <select name="module_id" class="form-input" onchange="this.form.submit()">
          <option value="" disabled <%= !selectedModule ? 'selected' : '' %>>— choose a module —</option>
          <% modules.forEach(m => { %>
            <option value="<%= m.id %>" <%= selectedModule && selectedModule.id === m.id ? 'selected' : '' %>>
              <%= m.module_code ? `${m.module_code} — ` : '' %><%= m.module_name %>
            </option>
          <% }) %>
        </select>
      </div>
      <button type="submit" class="btn-primary flex-shrink-0">View</button>
    </form>
  </div>

  <% if (!selectedModule) { %>
    <div class="card text-center py-12">
      <p class="text-5xl mb-3">🎓</p>
      <p class="text-gray-500">Choose a module above to see the top achievers for that module.</p>
    </div>

  <% } else if (top.length === 0) { %>
    <div class="card text-center py-12">
      <p class="text-4xl mb-3">📊</p>
      <p class="text-gray-600 font-semibold"><%= selectedModule.module_name %></p>
      <p class="text-gray-400 mt-1 text-sm">No quiz attempts in this module yet. Be the first!</p>
      <a href="/student/practice?module_id=<%= selectedModule.id %>" class="btn-primary mt-4 inline-block">🎯 Practice Now</a>
    </div>

  <% } else { %>

  <!-- Module badge -->
  <div class="flex items-center gap-2">
    <div class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: <%= selectedModule.colour || '#6366f1' %>"></div>
    <h2 class="text-lg font-bold text-gray-800"><%= selectedModule.module_name %></h2>
    <% if (selectedModule.module_code) { %>
      <span class="badge bg-gray-100 text-gray-500"><%= selectedModule.module_code %></span>
    <% } %>
  </div>

  <!-- Podium (top 3) -->
  <% if (top.length >= 3) { %>
  <div class="flex items-end justify-center gap-4 pt-4 pb-2">

    <!-- 2nd place -->
    <div class="flex flex-col items-center">
      <% if (top[1].profile_picture) { %>
        <img src="<%= top[1].profile_picture %>" class="w-14 h-14 rounded-full object-cover ring-4 ring-gray-300 mb-2" />
      <% } else { %>
        <div class="w-14 h-14 rounded-full bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-xl ring-4 ring-gray-300 mb-2">
          <%= top[1].name.charAt(0).toUpperCase() %>
        </div>
      <% } %>
      <p class="text-xs font-semibold text-gray-700 text-center max-w-[80px] truncate"><%= top[1].name %></p>
      <p class="text-sm font-bold text-gray-500"><%= top[1].avg_score %>%</p>
      <div class="w-20 h-16 bg-gray-200 rounded-t-lg flex items-center justify-center mt-1">
        <span class="text-2xl">🥈</span>
      </div>
    </div>

    <!-- 1st place -->
    <div class="flex flex-col items-center -mb-2">
      <div class="text-3xl mb-1">👑</div>
      <% if (top[0].profile_picture) { %>
        <img src="<%= top[0].profile_picture %>" class="w-20 h-20 rounded-full object-cover ring-4 ring-yellow-400 mb-2" />
      <% } else { %>
        <div class="w-20 h-20 rounded-full bg-yellow-100 flex items-center justify-center text-yellow-700 font-bold text-2xl ring-4 ring-yellow-400 mb-2">
          <%= top[0].name.charAt(0).toUpperCase() %>
        </div>
      <% } %>
      <p class="text-sm font-bold text-gray-800 text-center max-w-[100px] truncate"><%= top[0].name %></p>
      <p class="text-base font-extrabold text-yellow-600"><%= top[0].avg_score %>%</p>
      <div class="w-24 h-24 bg-yellow-400 rounded-t-lg flex items-center justify-center mt-1">
        <span class="text-3xl">🥇</span>
      </div>
    </div>

    <!-- 3rd place -->
    <div class="flex flex-col items-center">
      <% if (top[2].profile_picture) { %>
        <img src="<%= top[2].profile_picture %>" class="w-14 h-14 rounded-full object-cover ring-4 ring-amber-600 mb-2" />
      <% } else { %>
        <div class="w-14 h-14 rounded-full bg-amber-100 flex items-center justify-center text-amber-700 font-bold text-xl ring-4 ring-amber-600 mb-2">
          <%= top[2].name.charAt(0).toUpperCase() %>
        </div>
      <% } %>
      <p class="text-xs font-semibold text-gray-700 text-center max-w-[80px] truncate"><%= top[2].name %></p>
      <p class="text-sm font-bold text-amber-700"><%= top[2].avg_score %>%</p>
      <div class="w-20 h-12 bg-amber-600 rounded-t-lg flex items-center justify-center mt-1">
        <span class="text-2xl">🥉</span>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Full ranked list -->
  <div class="card divide-y divide-gray-50">
    <% top.forEach((s, i) => { %>
    <div class="flex items-center gap-4 py-4 <%= s.id == user.id ? 'bg-indigo-50 -mx-6 px-6 rounded-xl' : '' %>">
      <!-- Rank badge -->
      <div class="flex-shrink-0 w-9 h-9 rounded-full flex items-center justify-center font-extrabold text-sm
        <%= i === 0 ? 'bg-yellow-400 text-white' : i === 1 ? 'bg-gray-300 text-gray-700' : i === 2 ? 'bg-amber-500 text-white' : 'bg-gray-100 text-gray-600' %>">
        <%= i + 1 %>
      </div>

      <!-- Avatar -->
      <% if (s.profile_picture) { %>
        <img src="<%= s.profile_picture %>" class="w-10 h-10 rounded-full object-cover flex-shrink-0" />
      <% } else { %>
        <div class="w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-700 font-bold flex-shrink-0">
          <%= s.name.charAt(0).toUpperCase() %>
        </div>
      <% } %>

      <!-- Name -->
      <div class="flex-1 min-w-0">
        <p class="font-semibold text-gray-900 truncate">
          <%= s.name %>
          <% if (s.id == user.id) { %><span class="ml-2 text-xs text-indigo-600 font-normal">(you)</span><% } %>
        </p>
        <p class="text-xs text-gray-400"><%= s.total_attempts %> attempt<%= s.total_attempts != 1 ? 's' : '' %></p>
      </div>

      <!-- Score bar -->
      <div class="flex items-center gap-3 flex-shrink-0">
        <div class="hidden sm:block w-28 h-2 bg-gray-100 rounded-full overflow-hidden">
          <div class="h-full rounded-full
            <%= parseFloat(s.avg_score) >= 85 ? 'bg-emerald-500' : parseFloat(s.avg_score) >= 60 ? 'bg-yellow-400' : 'bg-red-400' %>"
            style="width: <%= s.avg_score %>%"></div>
        </div>
        <span class="text-lg font-extrabold
          <%= parseFloat(s.avg_score) >= 85 ? 'text-emerald-600' : parseFloat(s.avg_score) >= 60 ? 'text-yellow-600' : 'text-red-500' %>">
          <%= s.avg_score %>%
        </span>
      </div>
    </div>
    <% }) %>
  </div>

  <!-- My rank (if not in top 5) -->
  <% if (myRank && !top.find(s => s.id == user.id)) { %>
  <div class="card bg-indigo-50 border border-indigo-100">
    <p class="text-xs text-indigo-500 uppercase font-semibold mb-2">Your Position in <%= selectedModule.module_name %></p>
    <div class="flex items-center gap-4">
      <div class="w-9 h-9 rounded-full bg-indigo-200 text-indigo-700 font-extrabold flex items-center justify-center flex-shrink-0">
        <%= myRank.rank %>
      </div>
      <div class="flex-1">
        <p class="font-semibold text-gray-900"><%= user.name %></p>
        <p class="text-xs text-gray-400"><%= myRank.total_attempts %> attempt<%= myRank.total_attempts != 1 ? 's' : '' %></p>
      </div>
      <span class="text-lg font-extrabold text-indigo-600"><%= myRank.avg_score %>%</span>
    </div>
    <p class="text-xs text-indigo-400 mt-3">Keep practising to climb the leaderboard! 🚀</p>
  </div>
  <% } else if (!myRank) { %>
  <div class="card bg-gray-50 border border-gray-100 text-center py-4">
    <p class="text-sm text-gray-400">You haven't attempted any quizzes in this module yet.</p>
    <a href="/student/practice?module_id=<%= selectedModule.id %>" class="btn-primary mt-3 inline-block text-sm">🎯 Start Practising</a>
  </div>
  <% } %>

  <% } %>
</div>

<%- include('../partials/footer') %>
