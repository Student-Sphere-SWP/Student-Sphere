<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>

<div class="max-w-3xl mx-auto space-y-6">
  <!-- Score card -->
  <%
    const pct = Math.round(score * 100 / total);
    let level = 'Need Practice';
    let levelColor = 'red';
    if (pct >= 85) { level = 'Mastered'; levelColor = 'green'; }
    else if (pct >= 70) { level = 'Proficient'; levelColor = 'emerald'; }
    else if (pct >= 50) { level = 'Getting There'; levelColor = 'yellow'; }
  %>
  <div class="card text-center py-8">
    <div class="w-24 h-24 rounded-full mx-auto flex items-center justify-center text-3xl font-bold
      <%= levelColor === 'green' ? 'bg-green-100 text-green-700' :
          levelColor === 'emerald' ? 'bg-emerald-100 text-emerald-700' :
          levelColor === 'yellow' ? 'bg-yellow-100 text-yellow-700' :
          'bg-red-100 text-red-700' %>">
      <%= pct %>%
    </div>
    <h1 class="text-2xl font-bold text-gray-900 mt-4">Quiz Complete!</h1>
    <p class="text-gray-500 mt-1">Topic: <strong><%= topicName %></strong></p>
    <p class="text-gray-600 mt-1">You scored <strong><%= score %></strong> out of <strong><%= total %></strong></p>
    <span class="inline-block mt-3 px-4 py-1.5 rounded-full text-sm font-semibold
      <%= levelColor === 'green' ? 'bg-green-100 text-green-700' :
          levelColor === 'emerald' ? 'bg-emerald-100 text-emerald-700' :
          levelColor === 'yellow' ? 'bg-yellow-100 text-yellow-700' :
          'bg-red-100 text-red-700' %>">
      <%= level %>
    </span>
  </div>

  <!-- Breakdown -->
  <div class="card">
    <h2 class="text-base font-semibold text-gray-800 mb-4">Answer Breakdown</h2>
    <div class="space-y-4">
      <% results.forEach((r, idx) => { %>
      <div class="p-3 rounded-lg border <%= r.correct ? 'border-green-200 bg-green-50' : 'border-red-200 bg-red-50' %>">
        <p class="text-sm font-medium text-gray-800">
          <span class="<%= r.correct ? 'text-green-600' : 'text-red-600' %> mr-1"><%= r.correct ? '✓' : '✗' %></span>
          <%= idx + 1 %>. <%= r.question %>
        </p>
        <div class="mt-2 text-xs space-y-1">
          <p>Your answer: <strong class="<%= r.correct ? 'text-green-700' : 'text-red-700' %>"><%= r.userAnswer %></strong></p>
          <% if (!r.correct) { %>
          <p>Correct answer: <strong class="text-green-700"><%= r.correctAnswer %></strong></p>
          <% } %>
          <% if (r.explanation) { %>
          <p class="text-gray-500 italic mt-1"><%= r.explanation %></p>
          <% } %>
        </div>
      </div>
      <% }) %>
    </div>
  </div>

  <div class="flex gap-3">
    <a href="/student/modules/<%= moduleId %>" class="btn-secondary">Back to Module</a>
    <a href="/student/progress" class="btn-primary">View My Progress</a>
  </div>
</div>

<%- include('../partials/footer') %>
