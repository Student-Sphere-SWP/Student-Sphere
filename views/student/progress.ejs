<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div class="space-y-6">

  <h1 class="text-2xl font-bold text-gray-900">My Improvement</h1>

  <!-- Mastery summary cards -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <%
      const masteredCount  = topics.filter(t => parseFloat(t.avg_score) >= 85).length;
      const proficientCount = topics.filter(t => parseFloat(t.avg_score) >= 70 && parseFloat(t.avg_score) < 85).length;
      const gettingCount   = topics.filter(t => parseFloat(t.avg_score) >= 50 && parseFloat(t.avg_score) < 70).length;
      const needCount      = topics.filter(t => parseFloat(t.avg_score) < 50).length;
    %>
    <div class="card text-center">
      <p class="text-2xl font-bold text-green-600"><%= masteredCount %></p>
      <p class="text-xs text-gray-500 mt-1">Mastered</p>
    </div>
    <div class="card text-center">
      <p class="text-2xl font-bold text-emerald-600"><%= proficientCount %></p>
      <p class="text-xs text-gray-500 mt-1">Proficient</p>
    </div>
    <div class="card text-center">
      <p class="text-2xl font-bold text-yellow-600"><%= gettingCount %></p>
      <p class="text-xs text-gray-500 mt-1">Getting There</p>
    </div>
    <div class="card text-center">
      <p class="text-2xl font-bold text-red-500"><%= needCount %></p>
      <p class="text-xs text-gray-500 mt-1">Need Practice</p>
    </div>
  </div>

  <!-- Stats row -->
  <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
    <div class="card text-center">
      <p class="text-2xl font-bold text-indigo-600"><%= stats.total_quizzes || 0 %></p>
      <p class="text-xs text-gray-500 mt-1">Quizzes Taken</p>
    </div>
    <div class="card text-center">
      <% if (stats.overall_avg) { %>
        <p class="text-2xl font-bold <%= parseFloat(stats.overall_avg) >= 70 ? 'text-emerald-600' : parseFloat(stats.overall_avg) >= 50 ? 'text-yellow-600' : 'text-red-500' %>">
          <%= stats.overall_avg %>%
        </p>
      <% } else { %>
        <p class="text-2xl font-bold text-gray-300">--</p>
      <% } %>
      <p class="text-xs text-gray-500 mt-1">Overall Average</p>
    </div>
    <div class="card text-center">
      <p class="text-2xl font-bold <%= streak >= 3 ? 'text-orange-500' : streak >= 1 ? 'text-gray-700' : 'text-gray-300' %>">
        <%= streak %>
      </p>
      <p class="text-xs text-gray-500 mt-1">Day Streak</p>
    </div>
  </div>

  <!-- Score trend chart -->
  <% if (progressOverTime && progressOverTime.length) { %>
  <div class="card">
    <h2 class="text-base font-semibold text-gray-800 mb-4">Score Trend (Last 30 Days)</h2>
    <canvas id="trendChart" height="80"></canvas>
  </div>
  <% } %>

  <!-- Class test results -->
  <% if (classTestResults && classTestResults.length) { %>
  <div class="card">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-base font-semibold text-gray-800">Class Test Results</h2>
      <% if (parseInt(ctStats.test_count) > 0) { %>
      <span class="text-sm text-gray-500">Avg:
        <span class="font-bold <%= parseFloat(ctStats.avg_pct) >= 70 ? 'text-emerald-600' : parseFloat(ctStats.avg_pct) >= 50 ? 'text-yellow-600' : 'text-red-500' %>">
          <%= ctStats.avg_pct %>%
        </span>
      </span>
      <% } %>
    </div>
    <div class="space-y-2">
      <% classTestResults.forEach(ct => { %>
      <%
        const ctPct      = parseFloat(ct.pct);
        const ctBar      = ctPct >= 75 ? 'bg-emerald-500' : ctPct >= 60 ? 'bg-yellow-400' : ctPct >= 50 ? 'bg-orange-400' : 'bg-red-400';
        const ctText     = ctPct >= 75 ? 'text-emerald-600' : ctPct >= 60 ? 'text-yellow-600' : ctPct >= 50 ? 'text-orange-500' : 'text-red-500';
        const ctLabel    = ctPct >= 75 ? 'Great' : ctPct >= 60 ? 'Good' : ctPct >= 50 ? 'Average' : 'Needs Work';
        const ctLabelBg  = ctPct >= 75 ? 'bg-emerald-100 text-emerald-700' : ctPct >= 60 ? 'bg-yellow-100 text-yellow-700' : ctPct >= 50 ? 'bg-orange-100 text-orange-700' : 'bg-red-100 text-red-600';
      %>
      <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-xl">
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-gray-800 truncate"><%= ct.title %></p>
          <p class="text-xs text-gray-400 mt-0.5"><%= ct.module_name %><% if (ct.test_date) { %> &middot; <%= new Date(ct.test_date).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %><% } %></p>
        </div>
        <div class="flex items-center gap-3 flex-shrink-0">
          <div class="hidden sm:block w-24 h-2 bg-gray-200 rounded-full overflow-hidden">
            <div class="h-full rounded-full <%= ctBar %>" style="width:<%= ctPct %>%"></div>
          </div>
          <span class="text-sm font-bold <%= ctText %>"><%= ctPct %>%</span>
          <span class="badge text-xs <%= ctLabelBg %>"><%= ctLabel %></span>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- Per-module topic breakdown -->
  <% if (!topics.length) { %>
  <div class="card text-center py-12 text-gray-400">
    <p class="text-3xl mb-2">&#128202;</p>
    <p>No quiz attempts yet. Generate a quiz from a lecture note to get started!</p>
  </div>
  <% } else {
    const moduleMap = {};
    topics.forEach(t => {
      if (!moduleMap[t.module_id]) {
        moduleMap[t.module_id] = { module_name: t.module_name, colour: t.colour, topics: [] };
      }
      moduleMap[t.module_id].topics.push(t);
    });
  %>
  <% Object.values(moduleMap).forEach(mod => { %>
  <%
    const modAvg = mod.topics.reduce((sum, t) => sum + (parseFloat(t.avg_score) || 0), 0) / mod.topics.length;
    const modPct = modAvg.toFixed(0);
    const modLbl = modAvg >= 85 ? 'Mastered' : modAvg >= 70 ? 'Proficient' : modAvg >= 50 ? 'Getting There' : 'Need Practice';
    const modLblColor = modAvg >= 85 ? 'bg-green-100 text-green-700' : modAvg >= 70 ? 'bg-emerald-100 text-emerald-700' : modAvg >= 50 ? 'bg-yellow-100 text-yellow-700' : 'bg-red-100 text-red-700';
  %>
  <div class="card">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-3">
        <div class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: <%= mod.colour %>"></div>
        <h2 class="text-base font-semibold text-gray-800"><%= mod.module_name %></h2>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-xs text-gray-400"><%= mod.topics.length %> topic<%= mod.topics.length !== 1 ? 's' : '' %></span>
        <span class="badge <%= modLblColor %>">Avg <%= modPct %>% &middot; <%= modLbl %></span>
      </div>
    </div>

    <div class="space-y-3">
      <% mod.topics.forEach(t => { %>
      <%
        const bp = parseFloat(t.avg_score) || 0;
        const lbl = bp >= 85 ? 'Mastered' : bp >= 70 ? 'Proficient' : bp >= 50 ? 'Getting There' : 'Need Practice';
        const lblColor = bp >= 85 ? 'bg-green-100 text-green-700' : bp >= 70 ? 'bg-emerald-100 text-emerald-700' : bp >= 50 ? 'bg-yellow-100 text-yellow-700' : 'bg-red-100 text-red-700';
        const lastTried = t.last_attempt ? new Date(t.last_attempt).toLocaleDateString() : null;
      %>
      <div class="p-3 bg-gray-50 rounded-lg">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
          <div>
            <p class="text-sm font-medium text-gray-700"><%= t.topic_name %></p>
            <p class="text-xs text-gray-400">
              <%= t.attempts %> attempt<%= t.attempts != 1 ? 's' : '' %>
              <% if (lastTried) { %> &middot; Last: <%= lastTried %><% } %>
              <% if (t.trendDiff !== null && parseInt(t.attempts) > 1) { %>
              &middot; <span class="font-semibold <%= t.trendDiff >= 0 ? 'text-emerald-600' : 'text-red-500' %>">
                <%= t.trendDiff >= 0 ? '+' : '' %><%= t.trendDiff %>% since first attempt
              </span>
              <% } %>
            </p>
          </div>
          <div class="flex items-center gap-2">
            <span class="badge <%= lblColor %>"><%= lbl %></span>
            <% if (t.pdf_note_id && bp < 70) { %>
            <form method="POST" action="/student/generate-quiz" class="inline">
              <input type="hidden" name="pdf_note_id" value="<%= t.pdf_note_id %>" />
              <input type="hidden" name="questions_count" value="10" />
              <button type="submit" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 bg-indigo-50 hover:bg-indigo-100 px-2.5 py-1 rounded-lg transition-colors">
                Practice
              </button>
            </form>
            <% } %>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <div class="flex-1 bg-gray-200 rounded-full h-2">
            <div class="h-2 rounded-full transition-all
              <%= bp >= 85 ? 'bg-green-500' : bp >= 70 ? 'bg-emerald-500' : bp >= 50 ? 'bg-yellow-400' : 'bg-red-400' %>"
              style="width: <%= bp %>%"></div>
          </div>
          <span class="text-xs font-semibold text-gray-700 w-10 text-right"><%= bp.toFixed(0) %>%</span>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
  <% }) %>
  <% } %>

</div>

<% if (progressOverTime && progressOverTime.length) { %>
<script>
  const ctx = document.getElementById('trendChart').getContext('2d');
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: <%- JSON.stringify(progressOverTime.map(p => new Date(p.day).toLocaleDateString())) %>,
      datasets: [{
        label: 'Score %',
        data: <%- JSON.stringify(progressOverTime.map(p => parseFloat(p.avg_score).toFixed(1))) %>,
        borderColor: '#6366f1',
        backgroundColor: 'rgba(99,102,241,0.08)',
        borderWidth: 2,
        pointRadius: 4,
        tension: 0.3,
        fill: true
      }]
    },
    options: {
      responsive: true,
      scales: {
        y: { min: 0, max: 100, ticks: { callback: v => v + '%' } }
      },
      plugins: { legend: { display: false } }
    }
  });
</script>
<% } %>

<%- include('../partials/footer') %>