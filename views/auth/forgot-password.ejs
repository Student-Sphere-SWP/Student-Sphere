<%- include('../partials/head', { title: 'Forgot Password' }) %>

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:16px;background-image:linear-gradient(rgba(0,0,0,0.55),rgba(0,0,0,0.55)),url('/images/login_bg.jpg');background-size:cover;background-position:center;background-color:#1a202c;">
  <div style="width:100%;max-width:440px;">
    <div style="text-align:center;margin-bottom:32px;">
      <img src="/images/logo.jpg" alt="Student Sphere Logo" style="margin:0 auto 16px;display:block;width:96px;height:96px;border-radius:50%;object-fit:cover;box-shadow:0 8px 32px rgba(0,0,0,0.4);border:4px solid rgba(255,255,255,0.15);" />
      <h1 style="font-size:24px;font-weight:800;color:#fff;margin:0;">Student Sphere</h1>
    </div>

    <div style="background:rgba(15,12,30,0.95);backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,0.12);border-radius:24px;padding:32px;">
      <h2 style="font-size:20px;font-weight:700;color:#f8fafc;margin:0 0 8px 0;">Forgot your password?</h2>
      <p style="color:#64748b;font-size:14px;margin:0 0 24px 0;">Enter your email and we'll send you a reset link.</p>

      <%- include('../partials/flash') %>

      <form method="POST" action="/forgot-password" class="space-y-5">
        <div>
          <label class="form-label" for="email">Email address</label>
          <input type="email" id="email" name="email" required
                 class="form-input" placeholder="you@example.com" />
        </div>
        <button type="submit" class="btn-primary w-full justify-center py-2.5">
          Send reset link
        </button>
      </form>

      <p style="margin-top:24px;text-align:center;font-size:14px;color:#64748b;">
        <a href="/login" style="color:#a78bfa;font-weight:600;text-decoration:none;">← Back to login</a>
      </p>
    </div>
  </div>
</div>

</body></html>