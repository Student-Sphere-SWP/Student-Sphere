<%- include('../partials/head', { title: 'Register' }) %>

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:16px;background-image:linear-gradient(rgba(0,0,0,0.55),rgba(0,0,0,0.55)),url('/images/login_bg.jpg');background-size:cover;background-position:center;background-color:#1a202c;">
  
  <div style="width:100%;max-width:440px;padding:32px 0;">
    <div style="text-align:center;margin-bottom:32px;">
      <img src="/images/logo.jpg" alt="Student Sphere Logo" style="margin:0 auto 16px;display:block;width:96px;height:96px;border-radius:50%;object-fit:cover;box-shadow:0 8px 32px rgba(0,0,0,0.4);border:4px solid rgba(255,255,255,0.15);" />
      <h1 style="font-size:24px;font-weight:800;color:#fff;margin:0;">Student Sphere</h1>
      <p style="color:rgba(255,255,255,0.7);font-size:13px;margin:4px 0 0 0;">Create your student account</p>
    </div>

    <div style="background:rgba(15,12,30,0.95);backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,0.12);border-radius:24px;padding:32px;">
      <h2 style="font-size:20px;font-weight:700;color:#f8fafc;margin:0 0 24px 0;">Create an account</h2>

      <%- include('../partials/flash') %>

      <form method="POST" action="/register" enctype="multipart/form-data" class="space-y-5">

        <div class="flex flex-col items-center gap-3">
          <div id="avatar-preview" style="width:80px;height:80px;border-radius:50%;border:2px dashed rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;overflow:hidden;cursor:pointer;background:rgba(20,16,38,0.6);">
            <span style="color:#64748b;font-size:12px;text-align:center;padding:0 8px;">Photo<br/>(optional)</span>
          </div>
          <input type="file" id="profile_picture" name="profile_picture" accept="image/*" class="hidden" />
          <button type="button" onclick="document.getElementById('profile_picture').click()"
                  style="color:#a78bfa;font-size:12px;font-weight:600;background:none;border:none;cursor:pointer;text-decoration:none;">
            Upload profile picture
          </button>
        </div>

        <div>
          <label class="form-label" for="name">Full name</label>
          <input type="text" id="name" name="name" required autocomplete="name"
                 class="form-input" placeholder="Jane Doe" minlength="2" maxlength="100" />
        </div>

        <div>
          <label class="form-label" for="email">Email address</label>
          <input type="email" id="email" name="email" required autocomplete="email"
                 class="form-input" placeholder="you@example.com" />
        </div>

        <div>
          <label class="form-label" for="password">Password</label>
          <input type="password" id="password" name="password" required autocomplete="new-password"
                 class="form-input" placeholder="At least 8 characters" minlength="8" />
        </div>

        <div>
          <label class="form-label" for="confirm_password">Confirm password</label>
          <input type="password" id="confirm_password" name="confirm_password" required autocomplete="new-password"
                 class="form-input" placeholder="Re-enter your password" />
        </div>

        <p style="font-size:12px;color:#64748b;background:rgba(20,16,38,0.6);border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:12px;">
          Student accounts are self-registered. Lecturer and Mentor accounts are created by an administrator.
        </p>

        <button type="submit" class="btn-primary w-full justify-center py-2.5">
          Create account
        </button>
      </form>

      <p style="margin-top:24px;text-align:center;font-size:14px;color:#64748b;">
        Already have an account?
        <a href="/login" style="color:#a78bfa;font-weight:600;text-decoration:none;">Sign in</a>
      </p>
    </div>
  </div>
</div>

<script>
  const input   = document.getElementById('profile_picture');
  const preview = document.getElementById('avatar-preview');

  input.addEventListener('change', () => {
    const file = input.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = e => {
      preview.innerHTML = `<img src="${e.target.result}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />`;
    };
    reader.readAsDataURL(file);
  });

  const form = document.querySelector('form');
  form.addEventListener('submit', e => {
    const pw  = document.getElementById('password').value;
    const cpw = document.getElementById('confirm_password').value;
    if (pw !== cpw) {
      e.preventDefault();
      alert('Passwords do not match.');
    }
  });
</script>

</body>
</html>