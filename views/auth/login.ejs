<%- include('../partials/head', { title: 'Login' }) %>

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:16px;background-image:linear-gradient(rgba(0,0,0,0.55),rgba(0,0,0,0.55)),url('/images/login_bg.jpg');background-size:cover;background-position:center;background-color:#1a202c;">
  
  <div style="width:100%;max-width:440px;position:relative;z-index:10;">
    <div style="text-align:center;margin-bottom:32px;">
      <div style="margin-bottom:16px;">
        <img src="/images/logo.jpg" alt="Student Sphere Logo" 
             style="margin:0 auto;width:112px;height:112px;border-radius:50%;object-fit:cover;box-shadow:0 8px 32px rgba(0,0,0,0.4);border:4px solid rgba(255,255,255,0.15);" />
      </div>
      <h1 style="font-size:24px;font-weight:800;color:#fff;margin:0;">Student Sphere</h1>
      <p style="color:rgba(255,255,255,0.7);font-size:13px;margin:4px 0 0 0;letter-spacing:1px;">WHERE STUDENTS AND SUCCESS COLLIDE</p>
    </div>

    <div style="background:rgba(15,12,30,0.95);backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,0.12);border-radius:24px;padding:32px;">
      <h2 style="font-size:20px;font-weight:700;color:#f8fafc;margin:0 0 24px 0;">Sign in to your account</h2>

      <%- include('../partials/flash') %>

      <form method="POST" action="/login" class="space-y-5">
        <div>
          <label class="form-label" for="email">Email address</label>
          <input type="email" id="email" name="email" required autocomplete="email"
                 class="form-input" placeholder="you@example.com" />
        </div>

        <div>
          <label class="form-label" for="password" style="display:flex;justify-content:space-between;align-items:center;">
            <span>Password</span>
            <a href="/forgot-password" style="color:#a78bfa;font-size:12px;font-weight:600;text-decoration:none;">
              Forgot password?
            </a>
          </label>
          <input type="password" id="password" name="password" required autocomplete="current-password"
                 class="form-input" placeholder="••••••••" />
        </div>

        <button type="submit" class="btn-primary w-full justify-center py-2.5">
          Sign in
        </button>
      </form>

      <p style="margin-top:24px;text-align:center;font-size:14px;color:#64748b;">
        New student?
        <a href="/register" style="color:#a78bfa;font-weight:600;text-decoration:none;">Create an account</a>
      </p>
    </div>
  </div>
</div>

</body>
</html>