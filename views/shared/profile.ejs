<%- include('../partials/head', { title: title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div style="max-width:700px;margin:0 auto;">
  <h1 style="font-size:26px;font-weight:800;color:#f8fafc;margin:0 0 24px 0;letter-spacing:-0.5px;">My Profile</h1>

  <div class="card">
    <form method="POST" action="/<%= user.role %>/profile" enctype="multipart/form-data" class="space-y-6">
      <div class="flex items-center gap-5">
        <div id="avatar-preview" style="width:80px;height:80px;border-radius:50%;border:2px dashed rgba(255,255,255,0.2);overflow:hidden;display:flex;align-items:center;justify-content:center;background:rgba(20,16,38,0.6);">
          <% if (profile.profile_picture) { %>
            <img src="<%= profile.profile_picture %>" alt="Profile" class="w-full h-full object-cover rounded-full" />
          <% } else { %>
            <span class="text-2xl font-bold text-gray-400"><%= profile.name.charAt(0).toUpperCase() %></span>
          <% } %>
        </div>
        <div>
          <input type="file" id="profile_picture_input" name="profile_picture" accept="image/*" class="hidden" />
          <button type="button" onclick="document.getElementById('profile_picture_input').click()"
                  class="btn-secondary text-xs">
            Change Photo
          </button>
          <p class="text-xs text-gray-400 mt-1">JPEG, PNG, WebP — max 20MB</p>
        </div>
      </div>

      <div>
        <label class="form-label" for="name">Full name</label>
        <input type="text" id="name" name="name" value="<%= profile.name %>" required
               class="form-input" minlength="2" maxlength="100" />
      </div>

      <div>
        <label class="form-label">Email address</label>
        <input type="email" value="<%= profile.email %>" disabled
               class="form-input" style="opacity:0.5;cursor:not-allowed;" />
        <p class="text-xs text-gray-400 mt-1">Email cannot be changed. Contact an admin if needed.</p>
      </div>

      <div>
        <label class="form-label" for="bio">Bio <span class="text-gray-400 font-normal">(optional)</span></label>
        <textarea id="bio" name="bio" rows="3" class="form-input" placeholder="Tell others a little about yourself..."><%= profile.bio || '' %></textarea>
      </div>

      <hr style="border:none;border-top:1px solid rgba(255,255,255,0.08);" />

      <div>
        <h3 style="font-size:14px;font-weight:700;color:#94a3b8;margin:0 0 16px 0;">Change Password <span style="font-weight:400;color:#64748b;">(leave blank to keep current)</span></h3>
        <div class="space-y-4">
          <div>
            <label class="form-label" for="current_password">Current password</label>
            <input type="password" id="current_password" name="current_password"
                   class="form-input" placeholder="Enter current password" autocomplete="current-password" />
          </div>
          <div>
            <label class="form-label" for="new_password">New password</label>
            <input type="password" id="new_password" name="new_password" minlength="8"
                   class="form-input" placeholder="At least 8 characters" autocomplete="new-password" />
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-3">
        <a href="/<%= user.role %>/dashboard" class="btn-secondary">Cancel</a>
        <button type="submit" class="btn-primary">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<script>
  const input = document.getElementById('profile_picture_input');
  input.addEventListener('change', () => {
    const file = input.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = e => {
      document.getElementById('avatar-preview').innerHTML =
        `<img src="${e.target.result}" class="w-full h-full object-cover rounded-full" />`;
    };
    reader.readAsDataURL(file);
  });
</script>

<%- include('../partials/footer') %>