<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div class="space-y-6">
  <div class="flex items-center gap-3">
    <a href="/admin/users" class="text-gray-400 hover:text-gray-600">← Users</a>
    <span class="text-gray-300">/</span>
    <h1 class="text-2xl font-bold text-gray-900">Module Assignments — <%= targetUser.name %></h1>
    <span class="badge <%= targetUser.role === 'lecturer' ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700' %>">
      <%= targetUser.role %>
    </span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Assign new module -->
    <div class="card">
      <h2 class="text-base font-semibold text-gray-800 mb-4">Assign a Module</h2>
      <form method="POST" action="/admin/users/<%= targetUser.id %>/modules" class="space-y-3">
        <input type="hidden" name="action" value="assign" />
        <select name="module_id" required class="form-input">
          <option value="">Select module…</option>
          <% allModules.forEach(m => { %>
            <% if (!assignedIds.has(m.id)) { %>
              <option value="<%= m.id %>"><%= m.module_code %> — <%= m.module_name %></option>
            <% } %>
          <% }) %>
        </select>
        <button type="submit" class="btn-primary w-full justify-center">Assign Module</button>
      </form>
    </div>

    <!-- Assigned modules -->
    <div class="card">
      <h2 class="text-base font-semibold text-gray-800 mb-4">Currently Assigned (<%= assigned.length %>)</h2>
      <% if (assigned.length === 0) { %>
        <p class="text-gray-400 text-sm text-center py-6">No modules assigned yet.</p>
      <% } else { %>
      <ul class="space-y-2">
        <% assigned.forEach(m => { %>
        <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 rounded-full" style="background-color: <%= m.colour %>"></div>
            <span class="text-sm font-medium text-gray-700"><%= m.module_code %></span>
            <span class="text-sm text-gray-500 hidden sm:inline">— <%= m.module_name %></span>
          </div>
          <form method="POST" action="/admin/users/<%= targetUser.id %>/modules"
                onsubmit="return confirm('Remove this module?')">
            <input type="hidden" name="action" value="remove" />
            <input type="hidden" name="module_id" value="<%= m.id %>" />
            <button type="submit" class="text-xs text-red-500 hover:underline">Remove</button>
          </form>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
