<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div style="max-width:1200px;margin:0 auto;">
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:24px;flex-wrap:wrap;">
    <a href="/admin/users" style="color:#a78bfa;font-size:13px;font-weight:600;text-decoration:none;">← Users</a>
    <span style="color:#475569;">/</span>
    <h1 style="font-size:26px;font-weight:800;color:#f8fafc;margin:0;letter-spacing:-0.5px;">Module Assignments — <%= targetUser.name %></h1>
    <span class="badge <%= targetUser.role === 'lecturer' ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700' %>">
      <%= targetUser.role %>
    </span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="card">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
        <div style="width:4px;height:24px;background:linear-gradient(180deg,#c4b5fd,#7c3aed);border-radius:2px;"></div>
        <h2 style="font-size:18px;font-weight:700;color:#f8fafc;margin:0;">Assign a Module</h2>
      </div>
      <form method="POST" action="/admin/users/<%= targetUser.id %>/modules" class="space-y-3">
        <input type="hidden" name="action" value="assign" />
        <select name="module_id" required class="form-input">
          <option value="">Select module…</option>
          <% allModules.forEach(m => { %>
            <% if (!assignedIds.has(m.id)) { %>
              <option value="<%= m.id %>"><%= m.module_code %> — <%= m.module_name %></option>
            <% } %>
          <% }) %>
        </select>
        <button type="submit" class="btn-primary w-full justify-center">Assign Module</button>
      </form>
    </div>

    <div class="card">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
        <div style="width:4px;height:24px;background:linear-gradient(180deg,#93c5fd,#2563eb);border-radius:2px;"></div>
        <h2 style="font-size:18px;font-weight:700;color:#f8fafc;margin:0;">Currently Assigned (<%= assigned.length %>)</h2>
      </div>
      <% if (assigned.length === 0) { %>
        <div style="text-align:center;padding:40px 20px;">
          <p style="color:#94a3b8;font-size:14px;font-weight:600;">No modules assigned yet.</p>
        </div>
      <% } else { %>
      <ul class="space-y-2">
        <% assigned.forEach(m => { %>
        <li style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-radius:14px;border:1px solid rgba(255,255,255,0.08);background:rgba(20,16,38,0.6);">
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 rounded-full" style="background-color: <%= m.colour %>"></div>
            <span class="text-sm font-medium text-gray-700"><%= m.module_code %></span>
            <span class="text-sm text-gray-500 hidden sm:inline">— <%= m.module_name %></span>
          </div>
          <form method="POST" action="/admin/users/<%= targetUser.id %>/modules"
                onsubmit="return confirm('Remove this module?')">
            <input type="hidden" name="action" value="remove" />
            <input type="hidden" name="module_id" value="<%= m.id %>" />
            <button type="submit" class="text-xs text-red-500 hover:underline">Remove</button>
          </form>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>