<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div style="max-width:1200px;margin:0 auto;">
  <h1 style="font-size:26px;font-weight:800;color:#f8fafc;margin:0 0 24px 0;letter-spacing:-0.5px;">Manage Enrollments</h1>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="card">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
        <div style="width:4px;height:24px;background:linear-gradient(180deg,#c4b5fd,#7c3aed);border-radius:2px;"></div>
        <h2 style="font-size:18px;font-weight:700;color:#f8fafc;margin:0;">Enroll Student in Module</h2>
      </div>
      <form method="POST" action="/admin/enrollments" class="space-y-4">
        <div>
          <label class="form-label">Student</label>
          <select name="student_id" required class="form-input">
            <option value="">Select student…</option>
            <% students.forEach(s => { %>
              <option value="<%= s.id %>"><%= s.name %> (<%= s.email %>)</option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="form-label">Module</label>
          <select name="module_id" required class="form-input">
            <option value="">Select module…</option>
            <% modules.forEach(m => { %>
              <option value="<%= m.id %>"><%= m.module_code %> — <%= m.module_name %></option>
            <% }) %>
          </select>
        </div>
        <button type="submit" class="btn-primary w-full justify-center">Enroll Student</button>
      </form>
    </div>

    <div class="card">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
        <div style="width:4px;height:24px;background:linear-gradient(180deg,#93c5fd,#2563eb);border-radius:2px;"></div>
        <h2 style="font-size:18px;font-weight:700;color:#f8fafc;margin:0;">Recent Enrollments</h2>
      </div>
      <div class="space-y-2 max-h-96 overflow-y-auto">
        <% enrollments.forEach(e => { %>
        <div style="padding:14px 16px;border-radius:14px;border:1px solid rgba(255,255,255,0.08);background:rgba(20,16,38,0.6);display:flex;align-items:center;justify-content:space-between;">
          <div>
            <p class="text-sm font-medium text-gray-700"><%= e.student_name %></p>
            <p class="text-xs text-gray-400"><%= e.module_code %> — <%= e.module_name %></p>
          </div>
          <form method="POST" action="/admin/enrollments/<%= e.id %>?_method=DELETE"
                onsubmit="return confirm('Remove this enrollment?')">
            <button type="submit" class="text-xs text-red-500 hover:underline">Remove</button>
          </form>
        </div>
        <% }) %>
        <% if (!enrollments.length) { %>
          <p class="text-gray-400 text-sm text-center py-6">No enrollments yet.</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>