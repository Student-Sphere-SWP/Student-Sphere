<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div style="max-width:700px;margin:0 auto;">
  <div style="display:flex;align-items:center;gap:8px;margin-bottom:24px;">
    <a href="/admin/users" style="color:#a78bfa;font-size:13px;font-weight:600;text-decoration:none;">← Users</a>
    <span style="color:#475569;">/</span>
    <h1 style="font-size:26px;font-weight:800;color:#f8fafc;margin:0;letter-spacing:-0.5px;">Edit User</h1>
  </div>

  <div class="card">
    <form method="POST" action="/admin/users/<%= editUser.id %>?_method=PUT" enctype="multipart/form-data" class="space-y-5">

      <div class="flex items-center gap-4">
        <div id="avatar-preview" style="width:64px;height:64px;border-radius:50%;border:2px dashed rgba(255,255,255,0.2);overflow:hidden;display:flex;align-items:center;justify-content:center;background:rgba(20,16,38,0.6);">
          <% if (editUser.profile_picture) { %>
            <img src="<%= editUser.profile_picture %>" class="w-full h-full object-cover rounded-full" alt="" />
          <% } else { %>
            <span class="text-xl font-bold text-gray-400"><%= editUser.name.charAt(0).toUpperCase() %></span>
          <% } %>
        </div>
        <input type="file" id="profile_picture" name="profile_picture" accept="image/*" class="hidden" />
        <button type="button" onclick="document.getElementById('profile_picture').click()" class="btn-secondary text-xs">Change Photo</button>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="form-label">Full name</label>
          <input type="text" name="name" value="<%= editUser.name %>" required class="form-input" minlength="2" />
        </div>
        <div>
          <label class="form-label">Email</label>
          <input type="email" name="email" value="<%= editUser.email %>" required class="form-input" />
        </div>
      </div>

      <div>
        <label class="form-label">Role</label>
        <select name="role" required class="form-input">
          <option value="student"  <%= editUser.role === 'student'  ? 'selected' : '' %>>Student</option>
          <option value="lecturer" <%= editUser.role === 'lecturer' ? 'selected' : '' %>>Lecturer</option>
          <option value="mentor"   <%= editUser.role === 'mentor'   ? 'selected' : '' %>>Mentor</option>
          <option value="admin"    <%= editUser.role === 'admin'    ? 'selected' : '' %>>Admin</option>
        </select>
      </div>

      <div>
        <label class="form-label">Bio <span class="text-gray-400 font-normal">(optional)</span></label>
        <textarea name="bio" rows="3" class="form-input"><%= editUser.bio || '' %></textarea>
      </div>

      <div>
        <label class="form-label">New Password <span class="text-gray-400 font-normal">(leave blank to keep current)</span></label>
        <input type="password" name="password" class="form-input" placeholder="Min 8 characters" minlength="8" />
      </div>

      <div class="flex justify-end gap-3">
        <a href="/admin/users" class="btn-secondary">Cancel</a>
        <button type="submit" class="btn-primary">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<script>
  const i = document.getElementById('profile_picture');
  i.addEventListener('change', () => {
    const f = i.files[0]; if (!f) return;
    const r = new FileReader();
    r.onload = e => { document.getElementById('avatar-preview').innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover rounded-full" />`; };
    r.readAsDataURL(f);
  });
</script>

<%- include('../partials/footer') %>