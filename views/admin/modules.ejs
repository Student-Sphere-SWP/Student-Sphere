<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', { user }) %>
<%- include('../partials/flash') %>

<div style="max-width:1200px;margin:0 auto;">
  <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;margin-bottom:24px;">
    <h1 style="font-size:26px;font-weight:800;color:#f8fafc;margin:0;letter-spacing:-0.5px;">Manage Modules</h1>
    <button onclick="document.getElementById('create-modal').classList.remove('hidden')" class="btn-primary">
      + New Module
    </button>
  </div>

  <div class="card p-0 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead style="background:rgba(20,16,38,0.8);border-bottom:1px solid rgba(255,255,255,0.08);">
          <tr>
            <th class="text-left px-6 py-3 text-xs font-semibold uppercase" style="color:#64748b;">Module</th>
            <th class="text-left px-6 py-3 text-xs font-semibold uppercase hidden md:table-cell" style="color:#64748b;">Description</th>
            <th class="text-left px-6 py-3 text-xs font-semibold uppercase" style="color:#64748b;">Students</th>
            <th class="text-right px-6 py-3 text-xs font-semibold uppercase" style="color:#64748b;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% modules.forEach(m => { %>
          <tr style="border-bottom:1px solid rgba(255,255,255,0.05);">
            <td class="px-6 py-3">
              <div class="flex items-center gap-3">
                <div class="w-3 h-8 rounded-full" style="background-color: <%= m.colour %>"></div>
                <div>
                  <p class="font-semibold text-gray-800"><%= m.module_code %></p>
                  <p class="text-xs text-gray-500"><%= m.module_name %></p>
                </div>
              </div>
            </td>
            <td class="px-6 py-3 text-gray-500 hidden md:table-cell text-xs max-w-xs truncate">
              <%= m.description || '—' %>
            </td>
            <td class="px-6 py-3 text-gray-600"><%= m.student_count %></td>
            <td class="px-6 py-3 text-right">
              <button onclick='openEditModal(<%- JSON.stringify(m.id) %>, <%- JSON.stringify(m.module_name) %>, <%- JSON.stringify(m.colour) %>, <%- JSON.stringify(m.description || "") %>)'
                      class="text-xs text-blue-600 hover:underline mr-3">Edit</button>
              <form method="POST" action="/admin/modules/<%= m.id %>?_method=DELETE" class="inline"
                    onsubmit="return confirm('Delete <%= m.module_code %>?')">
                <button type="submit" class="text-xs text-red-500 hover:underline">Delete</button>
              </form>
            </td>
          </tr>
          <% }) %>
          <% if (!modules.length) { %>
          <tr><td colspan="4" class="px-6 py-10 text-center" style="color:#64748b;">No modules yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Create Modal -->
<div id="create-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black bg-opacity-40" onclick="document.getElementById('create-modal').classList.add('hidden')"></div>
  <div style="position:relative;background:rgba(15,12,30,0.95);backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,0.15);border-radius:24px;padding:32px;width:100%;max-width:440px;">
    <h2 style="font-size:18px;font-weight:700;color:#f8fafc;margin:0 0 20px 0;">New Module</h2>
    <form method="POST" action="/admin/modules" class="space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="form-label">Module Code</label>
          <input type="text" name="module_code" required class="form-input" placeholder="CS101" maxlength="20" />
        </div>
        <div>
          <label class="form-label">Colour</label>
          <input type="color" name="colour" value="#6366F1" class="form-input h-10 p-1 cursor-pointer" />
        </div>
      </div>
      <div>
        <label class="form-label">Module Name</label>
        <input type="text" name="module_name" required class="form-input" placeholder="Introduction to Computer Science" />
      </div>
      <div>
        <label class="form-label">Description <span class="text-gray-400 font-normal">(optional)</span></label>
        <textarea name="description" rows="2" class="form-input"></textarea>
      </div>
      <div class="flex justify-end gap-3">
        <button type="button" onclick="document.getElementById('create-modal').classList.add('hidden')" class="btn-secondary">Cancel</button>
        <button type="submit" class="btn-primary">Create</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Modal -->
<div id="edit-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black bg-opacity-40" onclick="document.getElementById('edit-modal').classList.add('hidden')"></div>
  <div style="position:relative;background:rgba(15,12,30,0.95);backdrop-filter:blur(24px);border:1px solid rgba(255,255,255,0.15);border-radius:24px;padding:32px;width:100%;max-width:440px;">
    <h2 style="font-size:18px;font-weight:700;color:#f8fafc;margin:0 0 20px 0;">Edit Module</h2>
    <form id="edit-form" method="POST" class="space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="form-label">Module Name</label>
          <input type="text" id="edit-name" name="module_name" required class="form-input" />
        </div>
        <div>
          <label class="form-label">Colour</label>
          <input type="color" id="edit-colour" name="colour" class="form-input h-10 p-1 cursor-pointer" />
        </div>
      </div>
      <div>
        <label class="form-label">Description</label>
        <textarea id="edit-desc" name="description" rows="2" class="form-input"></textarea>
      </div>
      <div class="flex justify-end gap-3">
        <button type="button" onclick="document.getElementById('edit-modal').classList.add('hidden')" class="btn-secondary">Cancel</button>
        <button type="submit" class="btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>

<script>
function openEditModal(id, name, colour, desc) {
  document.getElementById('edit-form').action = `/admin/modules/${id}?_method=PUT`;
  document.getElementById('edit-name').value   = name;
  document.getElementById('edit-colour').value = colour;
  document.getElementById('edit-desc').value   = desc;
  document.getElementById('edit-modal').classList.remove('hidden');
}
</script>

<%- include('../partials/footer') %>