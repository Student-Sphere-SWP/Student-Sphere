<%- include('../partials/head', { title: 'Server Error' }) %>
<div class="min-h-screen flex items-center justify-center bg-gray-50">
  <div class="text-center">
    <h1 class="text-8xl font-bold text-red-200">500</h1>
    <h2 class="text-2xl font-semibold text-gray-800 mt-4">Something went wrong</h2>
    <p class="text-gray-500 mt-2">An unexpected error occurred. Please try again.</p>
    <% if (typeof error !== 'undefined' && process && process.env && process.env.NODE_ENV !== 'production') { %>
      <pre class="mt-4 text-left bg-gray-100 p-4 rounded text-xs text-red-700 max-w-lg mx-auto overflow-auto"><%= error %></pre>
    <% } %>
    <a href="javascript:history.back()" class="btn-primary mt-6 inline-flex">Go back</a>
  </div>
</div>
</body></html>
