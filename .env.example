# ============================
# Student Sphere - Environment Variables
# Copy this file to .env and fill in your values
# ============================

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (Supabase connection string)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_STORAGE_BUCKET=student-sphere-files

# Authentication
JWT_SECRET=your-very-long-random-jwt-secret-at-least-64-chars
SESSION_SECRET=your-session-secret-for-flash-messages

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Email (for password reset) - example using Gmail SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Student Sphere <your-email@gmail.com>

# App URL (used in password reset emails)
APP_URL=http://localhost:3000
